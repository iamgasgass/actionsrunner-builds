            "value" : "錯誤報告"
          }
        }
      }
    },
    "Bug report not attached" : {
      "comment" : "The title of the alert when the finished bug report cannot be added to the mail; the system's reason follows.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグレポートを添付できませんでした"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未附加错误报告"
