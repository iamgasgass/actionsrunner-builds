            "value" : "取消"
          }
        }
      }
    },
    "Can’t send yet" : {
      "comment" : "The title of the alert when Send is tapped while the Problem line or the details are empty. Nothing opens; the message says which is missing.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ送信できません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还不能发送"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還無法傳送"
          }
        }
      }
    },
    "Copying file" : {
      "comment" : "The title of the card over the sheet while a file that cannot be used where it is kept (not yet downloaded from its cloud storage, say) is copied first.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをコピー中"
