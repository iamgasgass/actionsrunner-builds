          }
        }
      }
    },
    "Bug report" : {
      "comment" : "The Android bug report, as the Create bug report row of Settings names it: a button of the bar, a row of the mail and a name for VoiceOver.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグレポート"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错误报告"
          }
        },
