          "stringUnit" : {
            "state" : "translated",
            "value" : "正在拷貝檔案"
          }
        }
      }
    },
    "Create bug report" : {
      "comment" : "The button of the card that asks for a bug report; the Create bug report row of Settings says the same.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バグレポートを作成"
          }
        },
        "zh-Hans" : {
