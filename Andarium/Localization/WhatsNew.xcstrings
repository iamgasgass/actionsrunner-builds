          "stringUnit" : {
            "state" : "translated",
            "value" : "修正部分3D遊戲和應用程式當機的問題"
          }
        }
      }
    },
    "Fixed high CPU use and heat after a network connection drops" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
