        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正使用陀螺儀時當機的問題"
          }
        }
      }
    },
    "Fixed apps installed with Install APK not appearing on Android’s home screen" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“APKをインストール”でインストールしたアプリがAndroidのホーム画面に表示されない問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了通过“安装APK”安装的应用未出现在Android主屏幕上的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正透過「安裝APK」安裝的應用程式未出現在Android主畫面的問題"
          }
        }
      }
    },
    "Fixed crashes in some 3D games and apps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の3Dゲームやアプリでクラッシュする問題を修正しました"
