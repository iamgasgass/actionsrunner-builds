        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了视频录制开头没有声音的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正錄影開頭沒有聲音的問題"
          }
        }
      }
    },
    "Fixed the virtual machine crashing on many iPhones" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くのiPhoneで仮想マシンがクラッシュする問題を修正しました"
