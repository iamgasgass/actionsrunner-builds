{
  "sourceLanguage" : "en",
  "strings" : {
    "A camera recording now ends and is saved when you leave Andarium" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andariumを離れると、カメラの録画が終了して保存されるようになりました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开Andarium时，相机视频录制现在会结束并保存"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開Andarium時，相機錄影現在會結束並儲存"
          }
        }
      }
    },
    "Browse the virtual machine’s internal storage, and import or export files and folders." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンの内部ストレージを閲覧し、ファイルやフォルダを読み込んだり書き出したりできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览虚拟机的内部存储空间，并导入或导出文件和文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽虛擬機器的內部儲存空間，並匯入或匯出檔案和檔案夾。"
          }
        }
      }
    },
    "Camera" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機"
          }
        }
      }
    },
    "Email the developer from the Info menu on Home, or from Settings while the virtual machine runs, with screenshots and a bug report if you like." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ホーム”の“情報”メニュー、または仮想マシンの実行中に“設定”から、デベロッパにメールを送信できます。スクリーンショットやバグレポートも添付できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“主页”的“信息”菜单中或虚拟机运行时的“设置”中向开发者发送电子邮件，还可以附上截屏和错误报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「首頁」的「資訊」選單中或虛擬機器執行時的「設定」中傳送電子郵件給開發者，還可以附上截圖和錯誤報告。"
          }
        }
      }
    },
    "File browser" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルブラウザ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件浏览器"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "檔案瀏覽器"
          }
        }
      }
    },
    "Fixed 3D graphics failing to start in apps that run PC programs" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC用のプログラムを実行するアプリで3Dグラフィックスが起動しない問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了在运行PC程序的应用中3D图形无法启动的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正在執行PC程式的應用程式中3D圖形無法啟動的問題"
          }
        }
      }
    },
    "Fixed Andarium quitting when installing a very large APK" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非常に大きなAPKをインストールするとAndariumが予期せず終了する問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了安装超大APK时Andarium意外退出的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正安裝超大APK時Andarium未預期結束的問題"
          }
        }
      }
    },
    "Fixed a crash when a network connection closes suddenly" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続が突然閉じられたときにクラッシュする問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了网络连接突然关闭时崩溃的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正網路連線突然關閉時當機的問題"
          }
        }
      }
    },
    "Fixed a crash when returning to Andarium from the background" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドからAndariumに戻るときにクラッシュする問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了从后台返回Andarium时崩溃的问题"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修正從背景返回Andarium時當機的問題"
          }
        }
      }
    },
    "Fixed a crash when using the gyroscope" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャイロスコープの使用時にクラッシュする問題を修正しました"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修复了使用陀螺仪时崩溃的问题"
