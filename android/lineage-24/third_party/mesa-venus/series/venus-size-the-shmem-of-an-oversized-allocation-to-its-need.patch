From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 10 Nov 2026 04:39:10 +0900
Subject: [PATCH] venus: size the shmem of an oversized allocation to its need

An allocation larger than a pool serves gets a shmem of its own, and so does
the upload buffer of a command that large. Both were sized to the next power
of two, the size the shmem cache is keyed by. The cache keeps nothing above
64 MiB, so above that the power of two buys nothing: the shmem is destroyed
with its last reference, and it only takes up to twice the allocation from
the aperture of the blob heap while the call runs. A reply of 274 MB took 512
MiB, next to the burst of resources an application had just imported.

Size such a shmem to the allocation rounded up to a whole MiB when it is
larger than the cache keeps. Sizes up to 64 MiB are unchanged, and so is what
the cache serves. The upload encoder does not double its buffer past the
rounded size for a command that gets a shmem of its own.

The size test covers the rounding and its overflow limit, the ring test checks
the largest shmem a large reply and a large command create, and the renderer
checks that the limit matches the cache's buckets.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../tests/vn_renderer_shmem_pool_size_test.c  | 21 ++++++++++++++
 .../vulkan/tests/vn_ring_release_test.c       | 28 ++++++++++++++++++-
 src/virtio/vulkan/vn_cs.c                     | 13 +++++++++
 src/virtio/vulkan/vn_renderer_internal.c      | 10 +++++++
 .../vulkan/vn_renderer_shmem_pool_size.h      | 28 +++++++++++++++++++
 src/virtio/vulkan/vn_renderer_util.c          |  4 +--
 6 files changed, 101 insertions(+), 3 deletions(-)

diff --git a/src/virtio/vulkan/tests/vn_renderer_shmem_pool_size_test.c b/src/virtio/vulkan/tests/vn_renderer_shmem_pool_size_test.c
index 0c5ed01f2cc20abbfe6add7a1303cc8e3e30e318..6b722fc26a9f988fd4ffbee6c315897327525c20 100644
--- a/src/virtio/vulkan/tests/vn_renderer_shmem_pool_size_test.c
+++ b/src/virtio/vulkan/tests/vn_renderer_shmem_pool_size_test.c
@@ -48,6 +48,27 @@ main(void)
    /* A size no power of two reaches reports failure instead of looping. */
    CHECK(vn_renderer_shmem_pool_shmem_size(min_alloc, SIZE_MAX) == 0);
 
+   /* The shmem of an allocation that gets one of its own keeps the power of
+    * two where a shmem cache serves it (up to 64 MiB), and past that is the
+    * allocation rounded up to a whole MiB. */
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(
+            min_alloc, VN_RENDERER_SHMEM_POOL_MAX_SIZE + 1) == (size_t)32 << 20);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(min_alloc, (size_t)40 << 20) ==
+         (size_t)64 << 20);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(min_alloc, (size_t)64 << 20) ==
+         (size_t)64 << 20);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(
+            min_alloc, ((size_t)64 << 20) + 1) == (size_t)65 << 20);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(min_alloc, (size_t)240565361) ==
+         (size_t)230 << 20);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(min_alloc, (size_t)273916521) ==
+         (size_t)262 << 20);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(min_alloc, (size_t)256 << 20) ==
+         (size_t)256 << 20);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(min_alloc, SIZE_MAX) == 0);
+   CHECK(vn_renderer_shmem_pool_dedicated_shmem_size(
+            min_alloc, SIZE_MAX - ((size_t)1 << 20) + 2) == 0);
+
    printf("vn_renderer_shmem_pool_size passed\n");
    return 0;
 }
diff --git a/src/virtio/vulkan/tests/vn_ring_release_test.c b/src/virtio/vulkan/tests/vn_ring_release_test.c
index 3ff8ff05035ceccd5e16ef2c11d111c1c0460828..203f70d06319f3eeaffc20c6774adf9a8760d498 100644
--- a/src/virtio/vulkan/tests/vn_ring_release_test.c
+++ b/src/virtio/vulkan/tests/vn_ring_release_test.c
@@ -56,6 +56,8 @@ static struct {
    size_t live_bytes;
    /* live shmems that a pool does not serve: 16 MiB and up */
    unsigned live_large;
+   /* the largest shmem created since the last reset */
+   size_t largest_created;
    uint32_t next_res_id;
    struct vn_renderer_shmem *ring_shmem;
    size_t ring_shmem_size;
@@ -81,6 +83,8 @@ fake_shmem_create(UNUSED struct vn_renderer *renderer, size_t size)
    fake.live_bytes += size;
    if (size >= 16 * MIB)
       fake.live_large++;
+   if (size > fake.largest_created)
+      fake.largest_created = size;
    if (!fake.ring_shmem && size == fake.ring_shmem_size)
       fake.ring_shmem = &shmem->base;
    return &shmem->base;
@@ -185,14 +189,18 @@ test_free(UNUSED void *user_data, void *memory)
 
 /* One command that waits for a reply: `command_size` bytes of zeros and a
  * reply of `reply_size`.  Returns the live large shmems once the caller is
- * done with the reply and the ring is not submitted to again.
+ * done with the reply and the ring is not submitted to again, and the largest
+ * shmem the call created.
  */
+static size_t last_largest;
+
 static int
 run_command(struct vn_ring *ring,
             size_t command_size,
             size_t reply_size,
             unsigned *out_live_large)
 {
+   fake.largest_created = 0;
    void *command = calloc(1, command_size);
    CHECK(command);
 
@@ -212,6 +220,7 @@ run_command(struct vn_ring *ring,
 
    vn_ring_free_command_reply(ring, &submit);
    *out_live_large = fake.live_large;
+   last_largest = fake.largest_created;
    return 0;
 }
 
@@ -268,6 +277,23 @@ main(void)
    CHECK(!run_command(ring, 20 * MIB, 20 * MIB, &live_large));
    CHECK(live_large == 0);
 
+   /* The shmem of its own is as large as the allocation needs.  Sizes that a
+    * shmem cache serves (up to 64 MiB) stay powers of two; past them nothing
+    * would keep the shmem, and a power of two only takes aperture from the
+    * rest of the process while the call runs. */
+   CHECK(!run_command(ring, 64, 24 * MIB, &live_large));
+   CHECK(live_large == 0 && last_largest == 32 * MIB);
+   CHECK(!run_command(ring, 64, 40 * MIB, &live_large));
+   CHECK(live_large == 0 && last_largest == 64 * MIB);
+   CHECK(!run_command(ring, 64, 70 * MIB + 4, &live_large));
+   CHECK(live_large == 0 && last_largest == 71 * MIB);
+   CHECK(!run_command(ring, 24 * MIB, 64, &live_large));
+   CHECK(live_large == 0 && last_largest == 32 * MIB);
+   CHECK(!run_command(ring, 40 * MIB, 64, &live_large));
+   CHECK(live_large == 0 && last_largest == 64 * MIB);
+   CHECK(!run_command(ring, 70 * MIB + 4, 64, &live_large));
+   CHECK(live_large == 0 && last_largest == 71 * MIB);
+
    vn_ring_destroy(ring);
    vn_renderer_shmem_pool_fini(&renderer, &instance->reply_shmem_pool);
    vn_renderer_shmem_pool_fini(&renderer, &instance->cs_shmem_pool);
diff --git a/src/virtio/vulkan/vn_cs.c b/src/virtio/vulkan/vn_cs.c
index 7b0e87e1891958fd7413e79cb96ccf2fafe9f128..0b36eb7049068ce80f288c5c5a53d028874d532b 100644
--- a/src/virtio/vulkan/vn_cs.c
+++ b/src/virtio/vulkan/vn_cs.c
@@ -275,6 +275,19 @@ vn_cs_encoder_reserve_internal(struct vn_cs_encoder *enc, size_t size)
          return false;
    }
 
+   /* A request that gets a shmem of its own, as the upload of a command of
