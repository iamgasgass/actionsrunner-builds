+    * shmem (see vn_renderer_shmem_pool_size.h), not doubled up to a power of
+    * two.
+    */
+   if (enc->storage_type == VN_CS_ENCODER_STORAGE_SHMEM_ARRAY &&
+       vn_renderer_shmem_pool_is_dedicated(size)) {
+      const size_t own_size = vn_renderer_shmem_pool_dedicated_shmem_size(
+         enc->min_buffer_size, size);
+      if (own_size && own_size < buf_size)
+         buf_size = own_size;
+   }
+
    struct vn_renderer_shmem *shmem;
    size_t buf_offset;
    if (enc->storage_type == VN_CS_ENCODER_STORAGE_SHMEM_ARRAY) {
diff --git a/src/virtio/vulkan/vn_renderer_internal.c b/src/virtio/vulkan/vn_renderer_internal.c
index 5e29b190cf8298a7a58e80b655b9ff79c4cabc79..d5e71cc493ba0602bf496414d88cd7e561cf829d 100644
--- a/src/virtio/vulkan/vn_renderer_internal.c
+++ b/src/virtio/vulkan/vn_renderer_internal.c
@@ -5,6 +5,8 @@
 
 #include "vn_renderer_internal.h"
 
+#include "vn_renderer_shmem_pool_size.h"
+
 #ifdef HAVE_LIBDRM
 #include <xf86drm.h>
 
@@ -14,6 +16,14 @@
 /* 3 seconds */
 #define VN_RENDERER_SHMEM_CACHE_EXPIRACY (3ll * 1000 * 1000)
 
+/* the shmem pool sizes a shmem of its own by whether this cache keeps it */
+static_assert(
+   VN_RENDERER_SHMEM_CACHE_MAX_SIZE ==
+      ((size_t)1 << (sizeof(((struct vn_renderer_shmem_cache *)0)->buckets) /
+                        sizeof(struct vn_renderer_shmem_bucket) -
+                     1)),
+   "VN_RENDERER_SHMEM_CACHE_MAX_SIZE is the largest bucket of the cache");
+
 static void
 vn_renderer_shmem_cache_dump(struct vn_renderer_shmem_cache *cache)
 {
diff --git a/src/virtio/vulkan/vn_renderer_shmem_pool_size.h b/src/virtio/vulkan/vn_renderer_shmem_pool_size.h
index c6efd004b5d73cba3808588d16c0ac2af43c86db..dd53f71666bab1979aee59b6d2502e69e51c8dbd 100644
--- a/src/virtio/vulkan/vn_renderer_shmem_pool_size.h
+++ b/src/virtio/vulkan/vn_renderer_shmem_pool_size.h
@@ -8,6 +8,7 @@
 
 #include <stdbool.h>
 #include <stddef.h>
+#include <stdint.h>
 
 /* A shmem pool serves short-lived commands and replies from one shmem.  An
  * allocation larger than this is not a suballocation: it gets a shmem of its
@@ -19,6 +20,12 @@
  */
 #define VN_RENDERER_SHMEM_POOL_MAX_SIZE ((size_t)16 << 20)
 
+/* The largest shmem a renderer's shmem cache keeps (see
+ * vn_renderer_internal.h, which checks it against its buckets).  A shmem
+ * above it is freed with its last reference, whatever its size.
+ */
+#define VN_RENDERER_SHMEM_CACHE_MAX_SIZE ((size_t)64 << 20)
+
 static inline bool
 vn_renderer_shmem_pool_is_dedicated(size_t size)
 {
@@ -41,4 +48,25 @@ vn_renderer_shmem_pool_shmem_size(size_t min_alloc_size, size_t size)
    return alloc_size;
 }
 
+/* The size of the shmem of its own that serves an allocation of `size` for
+ * which vn_renderer_shmem_pool_is_dedicated holds.  Where a shmem cache would
+ * keep the shmem (up to VN_RENDERER_SHMEM_CACHE_MAX_SIZE) it is the power of
+ * two the cache is keyed by.  Above it nothing keeps the shmem, so it is the
+ * allocation rounded up to a whole MiB: a power of two would take up to twice
+ * the allocation from the aperture of the blob heap while the call runs.
+ * Returns 0 when no such size fits in a size_t.
+ */
+static inline size_t
+vn_renderer_shmem_pool_dedicated_shmem_size(size_t min_alloc_size, size_t size)
+{
+   const size_t pot = vn_renderer_shmem_pool_shmem_size(min_alloc_size, size);
+   if (!pot || pot <= VN_RENDERER_SHMEM_CACHE_MAX_SIZE)
+      return pot;
+
+   const size_t mib = (size_t)1 << 20;
+   if (size > SIZE_MAX - (mib - 1))
+      return 0;
+   return (size + (mib - 1)) & ~(mib - 1);
+}
+
 #endif /* VN_RENDERER_SHMEM_POOL_SIZE_H */
diff --git a/src/virtio/vulkan/vn_renderer_util.c b/src/virtio/vulkan/vn_renderer_util.c
index c4917837333f62ea0be157664494ad8e3e520734..8166ff338462a0819b6af7a23d94bda755fd9c2d 100644
--- a/src/virtio/vulkan/vn_renderer_util.c
+++ b/src/virtio/vulkan/vn_renderer_util.c
@@ -94,8 +94,8 @@ vn_renderer_shmem_pool_alloc(struct vn_renderer *renderer,
                              size_t *out_offset)
 {
    if (unlikely(vn_renderer_shmem_pool_is_dedicated(size))) {
-      const size_t alloc_size =
-         vn_renderer_shmem_pool_shmem_size(pool->min_alloc_size, size);
+      const size_t alloc_size = vn_renderer_shmem_pool_dedicated_shmem_size(
+         pool->min_alloc_size, size);
       if (!alloc_size)
          return NULL;
 
