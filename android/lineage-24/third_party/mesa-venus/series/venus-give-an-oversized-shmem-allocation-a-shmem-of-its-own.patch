 .../tests/vn_renderer_shmem_pool_size_test.c  | 53 +++++++++++++++++++
 .../vulkan/vn_renderer_shmem_pool_size.h      | 44 +++++++++++++++
 src/virtio/vulkan/vn_renderer_util.c          | 25 ++++++---
 src/virtio/vulkan/vn_renderer_util.h          |  1 +
 5 files changed, 123 insertions(+), 7 deletions(-)
 create mode 100644 src/virtio/vulkan/tests/vn_renderer_shmem_pool_size_test.c
 create mode 100644 src/virtio/vulkan/vn_renderer_shmem_pool_size.h

