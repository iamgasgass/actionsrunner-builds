 #include <media/AidlConversionCppNdk.h>
 
 #include "core-impl/StreamAlsaMonoPipe.h"
@@ -122,8 +128,38 @@ StreamAlsaMonoPipe::~StreamAlsaMonoPipe() {
     if (mIsInput) {
         const size_t i = 0;  // For the input case, only support a single device.
         LOG(VERBOSE) << __func__ << ": reading from sink " << i;
-        ssize_t framesRead = mSources[i]->read(buffer, frameCount);
-        LOG_IF(FATAL, framesRead < 0) << "Error reading from the pipe: " << framesRead;
+        // The I/O thread fills the pipe with the buffers that the device captures, and the client
+        // asks for its frames when it likes, so the pipe is often short of what it asks for. Wait
+        // for the frames, a bounded time, rather than making silence up for the missing ones: made
+        // up frames shift every captured frame behind them, and the timestamps of the recording
+        // with them. The I/O thread wakes the wait each time it has written to the pipe, and when
+        // it is stopped, which ends the wait as well.
+        constexpr int64_t kMinWaitNs = 100'000'000;
+        constexpr int64_t kMaxWaitNs = 250'000'000;
+        const int64_t frameDurationNs = static_cast<int64_t>(1'000'000'000) *
+                                        static_cast<int64_t>(frameCount) /
+                                        getContext().getSampleRate();
+        const auto deadline =
+                std::chrono::steady_clock::now() +
+                std::chrono::nanoseconds(std::clamp(4 * frameDurationNs, kMinWaitNs, kMaxWaitNs));
+        ssize_t framesRead = 0;
+        for (;;) {
+            const ssize_t chunk = mSources[i]->read(
+                    static_cast<char*>(buffer) + framesRead * mFrameSizeBytes,
+                    frameCount - framesRead);
+            LOG_IF(FATAL, chunk < 0) << "Error reading from the pipe: " << chunk;
+            framesRead += chunk;
+            if (framesRead >= static_cast<ssize_t>(frameCount) || !mIoThreadIsRunning ||
+                std::chrono::steady_clock::now() >= deadline) {
+                break;
+            }
+            if (chunk == 0) {
+                std::unique_lock lock(mInputMutex);
+                mInputCv.wait_until(lock, deadline, [&] {
+                    return !mIoThreadIsRunning || mSources[i]->availableToRead() > 0;
+                });
+            }
+        }
         if (ssize_t framesMissing = static_cast<ssize_t>(frameCount) - framesRead;
             framesMissing > 0) {
             LOG(WARNING) << __func__ << ": incomplete data received, inserting " << framesMissing
@@ -185,6 +221,9 @@ void StreamAlsaMonoPipe::inputIoThread(size_t idx) {
                                            mBufferSizeFrames - bufferFramesWritten);
                 if (framesWrittenOrError > 0) {
                     bufferFramesWritten += framesWrittenOrError;
+                    // Wake the wait of the client's 'transfer' for frames.
+                    std::lock_guard lock(mInputMutex);
+                    mInputCv.notify_one();
                 } else if (framesWrittenOrError == 0) {
                     // The pipe is full, as the client is behind: try again soon.
                     std::this_thread::sleep_for(std::chrono::milliseconds(1));
@@ -233,6 +272,11 @@ void StreamAlsaMonoPipe::outputIoThread(size_t idx) {
 
 void StreamAlsaMonoPipe::teardownIo() {
     mIoThreadIsRunning = false;
+    {
+        // Wake a 'transfer' that waits for frames: it ends its wait now that the thread is stopped.
+        std::lock_guard lock(mInputMutex);
+        mInputCv.notify_all();
+    }
     if (mIsInput) {
         LOG(DEBUG) << __func__ << ": shutting down pipes";
         for (auto& sink : mSinks) {
