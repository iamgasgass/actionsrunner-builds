 #include "c11/threads.h"
 #include "pipebuffer/pb_cache.h"
 #include "pipebuffer/pb_cache_reaper.h"
 #include "util/os_time.h"
+#include "util/pb_slab.h"
 #include "util/u_atomic.h"
 
 #include <stddef.h>
@@ -56,6 +58,14 @@ destroy_bo(void *winsys, struct pb_buffer_lean *buf)
    free(buf);
 }
 
+static void
+destroy_bo_unused(void *winsys, struct pb_buffer_lean *buf)
+{
+   (void)winsys;
+   (void)buf;
+   CHECK(!"the slab test's cache holds no buffer");
+}
+
 static bool
 can_reclaim_bo(void *winsys, struct pb_buffer_lean *buf)
 {
@@ -332,6 +342,298 @@ test_concurrent_add_reclaim_reap(void)
    pb_cache_deinit(&world.cache);
 }
 
+
+/* A slab of SLAB_ENTRIES entries of 64 bytes, as a driver's slab buffer holds
+ * its sub-allocations; an entry is busy while the device is still using it. */
+#define SLAB_ENTRIES 4
+#define SLAB_AGE_MS  150
+
+struct slab_entry {
+   struct pb_slab_entry base;
+   bool busy;
+};
+
+struct slab_world {
+   struct pb_slabs slabs;
+   struct pb_cache cache;
+   struct pb_cache_reaper *reaper;
+   int slabs_made;
+   int slabs_freed;
+};
+
+struct test_slab {
+   struct pb_slab base;
+   struct slab_entry entries[SLAB_ENTRIES];
+};
+
+static struct pb_slab *
+slab_alloc(void *priv, unsigned heap, unsigned entry_size, unsigned group_index)
+{
+   struct slab_world *world = priv;
+   struct test_slab *slab = calloc(1, sizeof(*slab));
+   CHECK(slab);
+
+   slab->base.num_entries = SLAB_ENTRIES;
+   slab->base.num_free = SLAB_ENTRIES;
+   slab->base.group_index = group_index;
+   slab->base.entry_size = entry_size;
+   list_inithead(&slab->base.free);
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++) {
+      slab->entries[i].base.slab = &slab->base;
+      list_addtail(&slab->entries[i].base.head, &slab->base.free);
+   }
+   p_atomic_inc(&world->slabs_made);
+   return &slab->base;
+}
+
+static void
+slab_free(void *priv, struct pb_slab *slab)
+{
+   struct slab_world *world = priv;
+   p_atomic_inc(&world->slabs_freed);
+   free(slab);
+}
+
+static bool
+slab_can_reclaim(void *priv, struct pb_slab_entry *entry)
+{
+   (void)priv;
+   return !p_atomic_read(&((struct slab_entry *)entry)->busy);
+}
+
+static void
+slab_world_init(struct slab_world *world)
+{
+   *world = (struct slab_world){0};
+   pb_cache_init(&world->cache, BUCKETS, 60u * 1000000u, 1.5f, 0, UINT64_MAX,
+                 offsetof(struct test_bo, entry), world, destroy_bo_unused,
+                 can_reclaim_bo);
+   CHECK(world->cache.buckets);
+   CHECK(pb_slabs_init(&world->slabs, 6, 8, 1, false, world, slab_can_reclaim,
+                       slab_alloc, slab_free));
+   world->reaper = pb_cache_reaper_create(&world->cache, "pb-slab-test");
+   CHECK(world->reaper);
+   pb_cache_reaper_set_slabs(world->reaper, &world->slabs, SLAB_AGE_MS);
+}
+
+static void
+slab_world_fini(struct slab_world *world)
+{
+   pb_cache_reaper_destroy(world->reaper);
+   pb_slabs_deinit(&world->slabs);
+   pb_cache_deinit(&world->cache);
+   CHECK(p_atomic_read(&world->slabs_made) ==
+         p_atomic_read(&world->slabs_freed));
+}
+
+static struct slab_entry *
+slab_take(struct slab_world *world)
+{
+   struct pb_slab_entry *entry = pb_slab_alloc(&world->slabs, 64, 0);
+   CHECK(entry);
+   return (struct slab_entry *)entry;
+}
+
+/* What bo_slab_destroy() does when the last reference goes. */
+static void
+slab_give(struct slab_world *world, struct slab_entry *entry)
+{
+   pb_slab_free(&world->slabs, &entry->base);
+   pb_cache_reaper_wake(world->reaper);
+}
+
+static void
+wait_slabs_freed(struct slab_world *world, int count)
+{
+   const int64_t start = now_ms();
+   while (p_atomic_read(&world->slabs_freed) < count) {
+      CHECK(now_ms() - start < WAIT_LIMIT_MS);
+      sleep_ms(2);
+   }
+}
+
+/* A slab all of whose entries went is freed by the reaper once they have been
+ * free for the age, not before, with no allocation to find it. */
+static void
+test_reaper_frees_an_empty_slab(void)
+{
+   struct slab_world world;
+   slab_world_init(&world);
+
+   struct slab_entry *entries[SLAB_ENTRIES];
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      entries[i] = slab_take(&world);
+   CHECK(p_atomic_read(&world.slabs_made) == 1);
+   const int64_t freed_at = now_ms();
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      slab_give(&world, entries[i]);
+
+   sleep_ms(SLAB_AGE_MS / 3);
+   CHECK(p_atomic_read(&world.slabs_freed) == 0);
+   wait_slabs_freed(&world, 1);
+   CHECK(now_ms() - freed_at >= SLAB_AGE_MS);
+   CHECK(now_ms() - freed_at < SLAB_AGE_MS + 1000);
+   CHECK(!pb_slabs_has_waiting(&world.slabs));
+
+   /* The reaper goes back to sleep and wakes for the next entry. */
+   sleep_ms(50);
+   struct slab_entry *again = slab_take(&world);
+   CHECK(p_atomic_read(&world.slabs_made) == 2);
+   slab_give(&world, again);
+   wait_slabs_freed(&world, 2);
+
+   slab_world_fini(&world);
+}
+
+/* A slab that keeps an entry is not freed, and the entries that are free
+ * stay free for the client to take again. */
+static void
+test_reaper_keeps_a_slab_in_use(void)
+{
+   struct slab_world world;
+   slab_world_init(&world);
+
+   struct slab_entry *entries[SLAB_ENTRIES];
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      entries[i] = slab_take(&world);
+   for (unsigned i = 1; i < SLAB_ENTRIES; i++)
+      slab_give(&world, entries[i]);
+   sleep_ms(SLAB_AGE_MS * 3);
+   CHECK(p_atomic_read(&world.slabs_freed) == 0);
+   CHECK(!pb_slabs_has_waiting(&world.slabs));
+
+   /* The entries the reaper reclaimed are taken again from the same slab. */
+   for (unsigned i = 1; i < SLAB_ENTRIES; i++)
+      entries[i] = slab_take(&world);
+   CHECK(p_atomic_read(&world.slabs_made) == 1);
+
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      slab_give(&world, entries[i]);
+   wait_slabs_freed(&world, 1);
+   slab_world_fini(&world);
+}
+
+/* An entry the device still uses is tried again, and its slab is freed once
+ * it is done, without anything else happening to the slabs. */
+static void
+test_reaper_waits_for_the_device(void)
+{
+   struct slab_world world;
+   slab_world_init(&world);
+
+   struct slab_entry *entries[SLAB_ENTRIES];
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      entries[i] = slab_take(&world);
+   p_atomic_set(&entries[1]->busy, true);
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      slab_give(&world, entries[i]);
+
+   sleep_ms(SLAB_AGE_MS * 3);
+   CHECK(p_atomic_read(&world.slabs_freed) == 0);
+   CHECK(pb_slabs_has_waiting(&world.slabs));
+
+   const int64_t done_at = now_ms();
+   p_atomic_set(&entries[1]->busy, false);
+   wait_slabs_freed(&world, 1);
+   /* The retry interval, with room for a loaded machine. */
+   CHECK(now_ms() - done_at < 1000);
+   slab_world_fini(&world);
+}
+
+/* The reclaim a host asks for takes every entry that can be reused, though
+ * the oldest are still busy; the allocator's own walk gives up after two. */
+static void
+test_reclaim_all_passes_busy_entries(void)
+{
+   struct slab_world world;
+   slab_world_init(&world);
+   /* Nothing ages while this runs. */
+   pb_cache_reaper_set_slabs(world.reaper, &world.slabs, 3600u * 1000u);
+
+   struct slab_entry *first[SLAB_ENTRIES], *second[SLAB_ENTRIES];
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      first[i] = slab_take(&world);
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      second[i] = slab_take(&world);
+   CHECK(p_atomic_read(&world.slabs_made) == 2);
+
+   p_atomic_set(&first[0]->busy, true);
+   p_atomic_set(&first[1]->busy, true);
+   slab_give(&world, first[0]);
+   slab_give(&world, first[1]);
+   slab_give(&world, first[2]);
+   slab_give(&world, first[3]);
+   for (unsigned i = 0; i < SLAB_ENTRIES; i++)
+      slab_give(&world, second[i]);
+
+   CHECK(pb_slabs_reclaim(&world.slabs) == 0);
+   CHECK(p_atomic_read(&world.slabs_freed) == 0);
+   CHECK(pb_slabs_reclaim_all(&world.slabs) == 6);
+   CHECK(p_atomic_read(&world.slabs_freed) == 1);
+
+   p_atomic_set(&first[0]->busy, false);
+   p_atomic_set(&first[1]->busy, false);
+   CHECK(pb_slabs_reclaim_all(&world.slabs) == 2);
+   CHECK(p_atomic_read(&world.slabs_freed) == 2);
+   slab_world_fini(&world);
+}
+
+/* Threads that take and give entries against the reaper. */
+struct slab_worker {
+   struct slab_world *world;
+   unsigned seed;
+};
+
+static int
+slab_worker_main(void *data)
+{
+   struct slab_worker *worker = data;
+   struct slab_world *world = worker->world;
+   struct slab_entry *held[6] = {0};
+
+   for (int i = 0; i < ITERATIONS; i++) {
+      worker->seed = worker->seed * 1664525u + 1013904223u;
+      const unsigned pick = (worker->seed >> 16) % 6;
+      if (held[pick]) {
+         slab_give(world, held[pick]);
+         held[pick] = NULL;
+      } else {
+         held[pick] = slab_take(world);
+      }
+      if ((worker->seed & 0x3ff) == 0)
+         sleep_ms(2);
+   }
+   for (int i = 0; i < 6; i++)
+      if (held[i])
+         slab_give(world, held[i]);
+   return 0;
+}
+
+static void
+test_concurrent_slabs_and_reaper(void)
+{
+   struct slab_world world;
+   slab_world_init(&world);
+   pb_cache_reaper_set_slabs(world.reaper, &world.slabs, 1);
+
+   thrd_t threads[WORKERS];
+   struct slab_worker workers[WORKERS];
+   for (int i = 0; i < WORKERS; i++) {
+      workers[i] = (struct slab_worker){&world, 777u + 104729u * i};
+      CHECK(thrd_create(&threads[i], slab_worker_main, &workers[i]) ==
+            thrd_success);
+   }
+   for (int i = 0; i < WORKERS; i++)
+      CHECK(thrd_join(threads[i], NULL) == thrd_success);
+
+   const int64_t start = now_ms();
+   while (pb_slabs_has_waiting(&world.slabs)) {
+      CHECK(now_ms() - start < WAIT_LIMIT_MS);
+      sleep_ms(2);
+   }
+   slab_world_fini(&world);
+}
+
 int
 main(void)
 {
@@ -340,6 +642,11 @@ main(void)
    test_reaper_leaves_reclaimed();
    test_reaper_destroy_is_prompt();
    test_concurrent_add_reclaim_reap();
-   printf("the reaper frees every expired buffer and no other\n");
+   test_reaper_frees_an_empty_slab();
+   test_reaper_keeps_a_slab_in_use();
+   test_reaper_waits_for_the_device();
+   test_reclaim_all_passes_busy_entries();
+   test_concurrent_slabs_and_reaper();
+   printf("the reaper frees every expired buffer and slab and no other\n");
    return 0;
 }
diff --git a/src/gallium/drivers/zink/zink_bo.c b/src/gallium/drivers/zink/zink_bo.c
index fa06199bb212150b1cb64015907bc882929a6a04..42c394eee1363db75cb78e48ffc072d7f2bae17a 100644
--- a/src/gallium/drivers/zink/zink_bo.c
+++ b/src/gallium/drivers/zink/zink_bo.c
@@ -181,12 +181,18 @@ bo_slab_destroy(struct zink_screen *screen, struct zink_bo *bo)
 
    bo_clear_vis_vram_full(screen, bo);
    pb_slab_free(&screen->pb.bo_slabs, &bo->u.slab.entry);
+   /* The reaper frees the slab once all of its entries have been free for a
+    * while, which an allocation of the entry's size would otherwise be the
+    * only thing to do. */
+   pb_cache_reaper_wake(screen->pb.bo_reaper);
 }
 
 static unsigned
 release_cached_buffers(struct zink_screen *screen)
 {
-   unsigned num_reclaims = pb_slabs_reclaim(&screen->pb.bo_slabs);
+   /* Every entry that can be reused, not the first few that can be: a slab
+    * that is free except for entries behind a busy one is freed too. */
+   unsigned num_reclaims = pb_slabs_reclaim_all(&screen->pb.bo_slabs);
    num_reclaims += pb_cache_release_all_buffers(&screen->pb.bo_cache);
    return num_reclaims;
 }
@@ -1379,6 +1385,12 @@ bo_slab_alloc_normal(void *priv, unsigned mem_type_idx, unsigned entry_size, uns
    return bo_slab_alloc(priv, mem_type_idx, entry_size, group_index, false);
 }
 
+/* How long every entry of a slab must have been free before the reaper frees
+ * the slab.  A client that frees small buffers and allocates them again each
+ * frame keeps its slabs; one that stopped gives them back about this long
+ * after, and the cache's own expiry after that. */
+#define ZINK_BO_SLAB_IDLE_MS 1000
+
 /* The most memory the cache keeps of buffers nobody uses.  A host driver that
  * reports its physical memory as one heap, as KosmicKrisp does, makes a
  * fraction of the heap a bound that follows the machine: 8 GiB on a Mac with
@@ -1427,17 +1439,20 @@ zink_bo_init(struct zink_screen *screen)
                         (void*)bo_slab_free)) {
       return false;
    }
+   pb_cache_reaper_set_slabs(screen->pb.bo_reaper, &screen->pb.bo_slabs,
+                             ZINK_BO_SLAB_IDLE_MS);
    return true;
 }
 
 void
 zink_bo_deinit(struct zink_screen *screen)
 {
-   /* Freeing the slabs' buffers adds them to the cache, so the reaper stops
