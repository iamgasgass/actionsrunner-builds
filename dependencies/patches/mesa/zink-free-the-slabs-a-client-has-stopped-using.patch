--- a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.c
+++ b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.c
@@ -6,6 +6,7 @@
 
 #include "c11/time.h"
 #include "util/cnd_monotonic.h"
+#include "util/pb_slab.h"
 #include "util/u_atomic.h"
 #include "util/u_memory.h"
 #include "util/u_thread.h"
@@ -16,6 +17,11 @@ struct pb_cache_reaper {
    struct pb_cache *cache;
    thrd_t thread;
 
+   /* The slab manager whose entries the thread also reclaims once they have
+    * waited slab_age_ms, or NULL. Read and written under lock. */
+   struct pb_slabs *slabs;
+   unsigned slab_age_ms;
+
    /* Guards stop and orders a wake-up after the thread's decision to sleep. */
    mtx_t lock;
    struct u_cnd_monotonic wake;
@@ -53,6 +59,19 @@ reaper_thread(void *data)
 
    mtx_lock(&reaper->lock);
    while (!reaper->stop) {
+      /* An entry that waited long enough is reclaimed first: a slab it
+       * empties hands its buffer to the cache, which the expiry below
+       * counts. */
+      int64_t slab_ms = -1;
+      struct pb_slabs *slabs = reaper->slabs;
+      if (slabs) {
+         mtx_unlock(&reaper->lock);
+         pb_slabs_reclaim_aged(slabs, reaper->slab_age_ms, &slab_ms);
+         mtx_lock(&reaper->lock);
+         if (reaper->stop)
+            break;
+      }
+
       const int64_t left_ms = pb_cache_next_expiry_ms(reaper->cache);
 
       if (left_ms == 0) {
@@ -61,16 +80,22 @@ reaper_thread(void *data)
          mtx_unlock(&reaper->lock);
          pb_cache_release_expired(reaper->cache);
          mtx_lock(&reaper->lock);
-      } else if (left_ms > 0) {
-         /* A buffer added meanwhile expires after this one, so only the
+      } else if (left_ms > 0 || slab_ms > 0) {
+         /* A buffer added meanwhile expires after this one, and an entry
+          * freed meanwhile ages after the ones that wait, so only the nearer
           * deadline, or the end of the reaper, needs to wake us. */
          struct timespec deadline;
-         deadline_after_ms(&deadline, left_ms);
+         deadline_after_ms(&deadline,
+                           left_ms < 0 ? slab_ms :
+                           slab_ms < 0 || left_ms < slab_ms ? left_ms : slab_ms);
          u_cnd_monotonic_timedwait(&reaper->wake, &reaper->lock, &deadline);
       } else {
          p_atomic_set(&reaper->sleeping, 1);
-         /* An addition that did not see the flag is in the cache by now. */
-         if (pb_cache_next_expiry_ms(reaper->cache) < 0 && !reaper->stop)
+         /* An addition that did not see the flag is in the cache by now,
+          * and a freed entry is on the slabs' list. */
+         if (pb_cache_next_expiry_ms(reaper->cache) < 0 &&
+             !(reaper->slabs && pb_slabs_has_waiting(reaper->slabs)) &&
+             !reaper->stop)
             u_cnd_monotonic_wait(&reaper->wake, &reaper->lock);
          p_atomic_set(&reaper->sleeping, 0);
       }
@@ -107,6 +132,20 @@ fail_alloc:
    return NULL;
 }
 
+void
+pb_cache_reaper_set_slabs(struct pb_cache_reaper *reaper,
+                          struct pb_slabs *slabs, unsigned min_age_ms)
+{
+   if (!reaper)
+      return;
+
+   mtx_lock(&reaper->lock);
+   reaper->slab_age_ms = min_age_ms;
+   reaper->slabs = slabs;
+   u_cnd_monotonic_signal(&reaper->wake);
+   mtx_unlock(&reaper->lock);
+}
+
 void
 pb_cache_reaper_wake(struct pb_cache_reaper *reaper)
 {
diff --git a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.h b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.h
index 2c48a44935698b7e3913e7785bb61fc74aaf7812..a901deb31a3a24631441e0a1070bc8a022f86edd 100644
--- a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.h
+++ b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper.h
@@ -25,6 +25,7 @@ extern "C" {
  * cache was created with.
  */
 struct pb_cache_reaper;
+struct pb_slabs;
 
 /**
  * Starts a reaper for \p cache, whose thread is named \p name.  The cache
@@ -34,9 +35,23 @@ struct pb_cache_reaper;
 struct pb_cache_reaper *
 pb_cache_reaper_create(struct pb_cache *cache, const char *name);
 
+/**
+ * Has the reaper also reclaim the entries of \p slabs that were freed at least
+ * \p min_age_ms ago and can be reused, so that a slab all of whose entries
+ * went that long ago is freed, and its buffer goes to the cache, without an
+ * allocation of its size to find it.  Entries freed and taken again sooner
+ * stay.  Call it once, before any entry is freed; the slabs must outlive the
+ * reaper, and the caller reports each entry it frees with
+ * pb_cache_reaper_wake().  Accepts NULL.
+ */
+void
+pb_cache_reaper_set_slabs(struct pb_cache_reaper *reaper,
+                          struct pb_slabs *slabs, unsigned min_age_ms);
+
 /**
  * Tells the reaper that a buffer was added to its cache, after
- * pb_cache_add_buffer() returned.  Cheap unless the reaper is asleep with
+ * pb_cache_add_buffer() returned, or that an entry was freed to its slabs,
+ * after pb_slab_free() returned.  Cheap unless the reaper is asleep with
  * nothing to wait for.  Accepts NULL, so a caller whose reaper could not be
  * created needs no test.
  */
diff --git a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper_test.c b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper_test.c
index b6a3eebe72c5dec96e74f34af99cc7010d3e8368..f506b51443eb41006af7576a9f411c643b871c09 100644
--- a/src/gallium/auxiliary/pipebuffer/pb_cache_reaper_test.c
+++ b/src/gallium/auxiliary/pipebuffer/pb_cache_reaper_test.c
@@ -3,16 +3,18 @@
  */
 
 /* pb_cache_release_expired(), pb_cache_next_expiry_ms() and the reaper that
- * frees a cache's expired buffers while nothing is added.  The buffers are
