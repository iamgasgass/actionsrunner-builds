+
+#define KK_TEST_MAX_MSL_ENTRIES 128
+
+/* One MSL source a shader holds, whichever form it holds it in. */
+struct kk_test_msl_entry {
+   /* Bytes of the text, with its terminator. */
+   uint32_t text_bytes;
+   /* Bytes of the form the shader holds: the compressed bytes, or the text. */
+   uint32_t resident_bytes;
+   /* Bytes the heap reports for the block that holds the compressed form; the
+    * text's own when the shader holds it plain. */
+   uint32_t heap_bytes;
+   /* Bytes the text compresses to with LZFSE, worked out here from the
+    * plain text. */
+   uint32_t recompressed_bytes;
+   bool packed;
+   /* Hash of the plain text, decompressed here with libcompression itself. */
+   uint64_t text_hash;
+   bool is_raster_variant;
+};
+
+struct kk_test_msl_stats {
+   uint32_t count;
+   struct kk_test_msl_entry entries[KK_TEST_MAX_MSL_ENTRIES];
+};
+
+/* Every MSL source of the shaders the command buffer has bound, with the
+ * shaders of its raster variants. */
+void kk_test_bound_msl(VkCommandBuffer command, struct kk_test_msl_stats *out);
+
+uint64_t kk_test_msl_resident_bytes(const struct kk_test_msl_stats *stats);
+uint64_t kk_test_msl_text_bytes(const struct kk_test_msl_stats *stats);
+uint64_t kk_test_msl_heap_bytes(const struct kk_test_msl_stats *stats);
+bool kk_test_msl_all_packed(const struct kk_test_msl_stats *stats);
+
+/* Bytes the process holds in its malloc zones, and its physical footprint. */
+uint64_t kk_test_heap_in_use(void);
+uint64_t kk_test_footprint(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/kosmickrisp/vulkan/tests/test_msl_pack.c b/src/kosmickrisp/vulkan/tests/test_msl_pack.c
new file mode 100644
index 0000000000000000000000000000000000000000..ca4496d78152ffea230e1e148a66c41ebacfbad1
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_msl_pack.c
@@ -0,0 +1,167 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ *
+ * The compressed form of a shader's MSL text: what packs and what stays plain,
+ * that the text comes back from either form, that a copy of the compressed
+ * bytes stands for the text, and that bytes that cannot be a compressed text
+ * are refused rather than decompressed into a buffer the wrong size.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "kosmickrisp/vulkan/kk_msl_pack.h"
+#include "util/ralloc.h"
+
+#define CHECK(condition)                                                       \
+   do {                                                                        \
+      if (!(condition)) {                                                      \
+         fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__, __LINE__,      \
+                 #condition);                                                  \
+         abort();                                                              \
+      }                                                                        \
+   } while (0)
+
+/* Text of about `size` bytes that looks like generated MSL. */
+static char *
+msl_like(unsigned size, unsigned seed)
+{
+   char *text = ralloc_strdup(NULL, "#include <metal_stdlib>\n");
+   for (unsigned i = 0; strlen(text) < size; i++) {
+      ralloc_asprintf_append(&text,
+                             "    t%u = t%u * float(%u.5e-01) + in.vary_%02u;\n",
+                             i, i / 2, (i * 7 + seed) % 97, i % 16);
+   }
+   return text;
+}
+
+static void
+set_text(struct msl_compile_data *data, char *text)
+{
+   memset(data, 0, sizeof(*data));
+   data->code = text;
+   data->entrypoint_name = ralloc_strdup(NULL, "main_entrypoint");
+}
+
+int main(void)
+{
+   struct msl_compile_data data;
+
+   /* A text of real size packs to a fraction of it, and comes back whole. */
+   char *original = msl_like(20000, 1);
+   const size_t original_size = strlen(original) + 1;
+   set_text(&data, ralloc_strdup(NULL, original));
+   CHECK(kk_msl_has_text(&data));
+   CHECK(kk_msl_resident_bytes(&data) == original_size);
+   CHECK(kk_msl_pack(&data));
+   CHECK(data.code == NULL && data.packed != NULL);
+   CHECK(data.code_size == original_size);
+   CHECK(data.packed_size * 3 < original_size);
+   CHECK(kk_msl_resident_bytes(&data) == data.packed_size);
+   CHECK(kk_msl_text_bytes(&data) == original_size);
+   CHECK(kk_msl_has_text(&data));
+   CHECK(kk_msl_pack(&data));
+   char *scratch = NULL;
+   const char *text = kk_msl_text(&data, &scratch);
+   CHECK(text != NULL && scratch == text);
+   CHECK(strcmp(text, original) == 0);
+   kk_msl_text_release(scratch);
+
+   /* A copy of the compressed bytes stands for the same text, and only for
+    * text of that size. */
+   struct msl_compile_data copy;
+   set_text(&copy, ralloc_strdup(NULL, original));
+   CHECK(kk_msl_pack_copy(&copy, &data));
+   CHECK(copy.code == NULL && copy.packed != NULL && copy.packed != data.packed);
+   CHECK(copy.packed_size == data.packed_size &&
+         memcmp(copy.packed, data.packed, data.packed_size) == 0);
+   struct msl_compile_data other;
+   set_text(&other, msl_like(5000, 2));
+   CHECK(!kk_msl_pack_copy(&other, &data));
+   CHECK(other.code != NULL && other.packed == NULL);
+   kk_msl_finish(&other);
+   kk_msl_finish(&copy);
+
+   /* The bytes of a cache are adopted as they are, and refused when they
+    * cannot be a text of the size they claim. */
+   struct msl_compile_data adopted;
+   memset(&adopted, 0, sizeof(adopted));
+   CHECK(kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed,
+                      data.packed_size, data.code_size));
+   CHECK(adopted.packed != data.packed && adopted.code == NULL);
+   text = kk_msl_text(&adopted, &scratch);
+   CHECK(text != NULL && strcmp(text, original) == 0);
+   kk_msl_text_release(scratch);
+   kk_msl_drop(&adopted);
+   CHECK(!kk_msl_has_text(&adopted));
+
+   CHECK(!kk_msl_adopt(&adopted, KK_MSL_CODEC_COUNT, data.packed,
+                       data.packed_size, data.code_size));
+   CHECK(!kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed, 0,
+                       data.code_size));
+   CHECK(!kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed,
+                       data.packed_size, 0));
+   CHECK(!kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed,
+                       data.code_size + 1, data.code_size));
+   CHECK(!kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed,
+                       data.packed_size, KK_MSL_MAX_CODE_SIZE + 1));
+   CHECK(!kk_msl_adopt(&adopted, KK_MSL_CODEC_STORED, original, 10, 11));
+   CHECK(!adopted.code && !adopted.packed);
+
+   /* Bytes cut short, or that stand for a text of another size, decompress to
+    * nothing. */
+   CHECK(kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed,
+                      data.packed_size / 2, data.code_size));
+   CHECK(kk_msl_text(&adopted, &scratch) == NULL && scratch == NULL);
+   kk_msl_drop(&adopted);
+   CHECK(kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed,
+                      data.packed_size, data.code_size - 1));
+   CHECK(kk_msl_text(&adopted, &scratch) == NULL && scratch == NULL);
+   kk_msl_drop(&adopted);
+   CHECK(kk_msl_adopt(&adopted, KK_MSL_CODEC_LZFSE, data.packed,
+                      data.packed_size, data.code_size + 1));
+   CHECK(kk_msl_text(&adopted, &scratch) == NULL && scratch == NULL);
+   kk_msl_finish(&adopted);
+
+   /* A stored text, the form of one that does not compress, stays plain. */
+   CHECK(kk_msl_adopt(&adopted, KK_MSL_CODEC_STORED, "plain text", 11, 11));
+   CHECK(adopted.code != NULL && adopted.packed == NULL);
+   text = kk_msl_text(&adopted, &scratch);
+   CHECK(text == adopted.code && scratch == NULL);
+   CHECK(!kk_msl_adopt(&adopted, KK_MSL_CODEC_STORED, "unterminated", 12, 12));
+   kk_msl_finish(&adopted);
+
+   /* Text that does not get smaller, or is too small to, is left alone. */
+   char noise[2000];
+   unsigned state = 12345;
+   for (unsigned i = 0; i < sizeof(noise) - 1; i++) {
+      state = state * 1664525u + 1013904223u;
+      noise[i] = 33 + (state >> 24) % 94;
+   }
+   noise[sizeof(noise) - 1] = '\0';
+   set_text(&data, ralloc_strdup(NULL, noise));
+   struct msl_compile_data noisy = data;
+   memset(&data, 0, sizeof(data));
+   CHECK(!kk_msl_pack(&noisy) || noisy.packed_size < sizeof(noise));
+   kk_msl_finish(&noisy);
+
+   struct msl_compile_data tiny;
+   set_text(&tiny, ralloc_strdup(NULL, ""));
+   CHECK(!kk_msl_pack(&tiny));
+   CHECK(tiny.code != NULL && kk_msl_resident_bytes(&tiny) == 1);
+   kk_msl_finish(&tiny);
+
+   /* An empty entry holds nothing, whichever way it is asked. */
+   struct msl_compile_data empty;
+   memset(&empty, 0, sizeof(empty));
+   CHECK(!kk_msl_has_text(&empty) && !kk_msl_pack(&empty));
+   CHECK(kk_msl_text(&empty, &scratch) == NULL);
+   CHECK(kk_msl_resident_bytes(&empty) == 0 && kk_msl_text_bytes(&empty) == 0);
+   kk_msl_finish(&empty);
+
+   ralloc_free(original);
+   printf("MSL text packing passed\n");
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/test_msl_packing.cpp b/src/kosmickrisp/vulkan/tests/test_msl_packing.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7f30af79073506b52f70bb229dea8369108d72b5
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/test_msl_packing.cpp
@@ -0,0 +1,692 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ *
+ * The MSL a pipeline was built from is the largest thing it keeps, and it is
+ * read again only to build another Metal pipeline from it and to write a
+ * pipeline cache.  A finished shader therefore holds the text compressed, and
+ * a pipeline cache carries the compressed bytes.  This checks that
+ *
+ *  - after pipelines are created, every MSL source a bound shader holds is the
+ *    compressed one, and the bytes the heap holds for it are the compressed
+ *    size, not the text's;
+ *  - the pipeline cache of those pipelines is smaller than the text, and a
+ *    cache loaded from it recreates the pipelines with the same text and keeps
+ *    it compressed too;
+ *  - a render pass that binds fewer attachments than the pipeline declares
+ *    builds its Metal pipeline from the compressed text and renders.
+ *
+ * "--bench N [BASE]" instead creates N pipelines, with constants from BASE up,
+ * and prints what they cost, as "metric <name> <value>" lines, for the
+ * comparison against a driver that keeps the text.
+ */
+
+#define VK_NO_PROTOTYPES
+#include <vulkan/vulkan.h>
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#include "msl_packing_state.h"
+#include "kk_test.h"
+
+static const uint32_t vertex_spirv[] =
+#include "msl_packing_shaders/pack.vert.h"
+;
+static const uint32_t fragment_spirv[] =
+#include "msl_packing_shaders/pack.frag.h"
+;
+static const uint32_t compute_spirv[] =
+#include "msl_packing_shaders/pack.comp.h"
+;
+
+static constexpr VkFormat kColorFormat = VK_FORMAT_R8G8B8A8_UNORM;
+/* The specialization constant of a pipeline, which gives its MSL text of its
+ * own. */
+static constexpr int kFirstVariant = 1000;
+/* A run that must not find the text of an earlier one in Metal's compile cache
+ * moves every pipeline's constant by this much. */
+static int variant_base = 0;
+
+using Clock = std::chrono::steady_clock;
+
+static double
+microseconds(Clock::time_point from, Clock::time_point to)
+{
+   return std::chrono::duration<double, std::micro>(to - from).count();
+}
+
+static double
+percentile(std::vector<double> values, double fraction)
+{
+   if (values.empty())
+      return 0;
+   std::sort(values.begin(), values.end());
+   return values[std::min(values.size() - 1,
+                          size_t(fraction * (values.size() - 1) + 0.5))];
+}
+
+int main(int argc, char **argv)
+{
+   std::setvbuf(stdout, nullptr, _IONBF, 0);
+   const bool bench = argc > 2 && std::strcmp(argv[1], "--bench") == 0;
+   const unsigned count = bench ? unsigned(std::atoi(argv[2])) : 6;
+   if (bench && argc > 3)
+      variant_base = std::atoi(argv[3]);
+   require(count > 0, "pipeline count");
+
+   kk_test_device t;
+   VkResult result;
+   kk_test_create_instance(&t, "msl-packing");
+
+   VkPhysicalDeviceDynamicRenderingUnusedAttachmentsFeaturesEXT unused{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DYNAMIC_RENDERING_UNUSED_ATTACHMENTS_FEATURES_EXT};
+   unused.dynamicRenderingUnusedAttachments = VK_TRUE;
+   VkPhysicalDeviceVulkan13Features features13{
+      VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+   features13.dynamicRendering = VK_TRUE;
+   features13.pNext = &unused;
+   const char *device_extensions[] = {
+      VK_EXT_DYNAMIC_RENDERING_UNUSED_ATTACHMENTS_EXTENSION_NAME};
+   kk_test_create_device(&t, &features13, nullptr, 1, device_extensions);
+   KK_LOAD_DEVICE_FUNCTIONS(t);
+   LOAD_D(vkCreateComputePipelines);
+   LOAD_D(vkCreateDescriptorSetLayout);
+   LOAD_D(vkDestroyDescriptorSetLayout);
+   LOAD_D(vkCreatePipelineCache);
+   LOAD_D(vkDestroyPipelineCache);
+   LOAD_D(vkGetPipelineCacheData);
+   LOAD_D(vkCmdSetViewport);
+   LOAD_D(vkCmdSetScissor);
+
+   VkShaderModule vertex_module =
+      kk_test_shader_module(&t, vertex_spirv, sizeof(vertex_spirv));
+   VkShaderModule fragment_module =
+      kk_test_shader_module(&t, fragment_spirv, sizeof(fragment_spirv));
+   VkShaderModule compute_module =
+      kk_test_shader_module(&t, compute_spirv, sizeof(compute_spirv));
+
+   VkPipelineLayoutCreateInfo graphics_layout_info{
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   VkPipelineLayout graphics_layout = VK_NULL_HANDLE;
+   result = vkCreatePipelineLayout(device, &graphics_layout_info, nullptr,
+                                   &graphics_layout);
+   require(result == VK_SUCCESS, "graphics layout", result);
+
+   VkDescriptorSetLayoutBinding storage{};
+   storage.binding = 0;
+   storage.descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+   storage.descriptorCount = 1;
+   storage.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+   VkDescriptorSetLayoutCreateInfo set_layout_info{
+      VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+   set_layout_info.bindingCount = 1;
+   set_layout_info.pBindings = &storage;
+   VkDescriptorSetLayout set_layout = VK_NULL_HANDLE;
+   result = vkCreateDescriptorSetLayout(device, &set_layout_info, nullptr,
+                                        &set_layout);
+   require(result == VK_SUCCESS, "set layout", result);
+   VkPipelineLayoutCreateInfo compute_layout_info{
+      VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+   compute_layout_info.setLayoutCount = 1;
+   compute_layout_info.pSetLayouts = &set_layout;
+   VkPipelineLayout compute_layout = VK_NULL_HANDLE;
+   result = vkCreatePipelineLayout(device, &compute_layout_info, nullptr,
+                                   &compute_layout);
+   require(result == VK_SUCCESS, "compute layout", result);
+
+   /* Both attachments are declared; the render pass of the variant check binds
+    * only the first. */
+   auto create_graphics = [&](unsigned index, VkPipelineCache cache,
+                              VkPipelineCreateFlags flags,
+                              VkPipeline *pipeline,
+                              bool dynamic_discard = false) {
+      int variant = kFirstVariant + variant_base + int(index);
+      VkSpecializationMapEntry entry{0, 0, sizeof(variant)};
+      VkSpecializationInfo specialization{1, &entry, sizeof(variant),
+                                          &variant};
+      VkPipelineShaderStageCreateInfo stages[2]{};
+      stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+      stages[0].module = vertex_module;
+      stages[0].pName = "main";
+      stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+      stages[1].module = fragment_module;
+      stages[1].pName = "main";
+      stages[1].pSpecializationInfo = &specialization;
+
+      VkPipelineVertexInputStateCreateInfo vi{
+         VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+      VkPipelineInputAssemblyStateCreateInfo ia{
+         VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+      ia.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+      VkPipelineViewportStateCreateInfo vp{
+         VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+      vp.viewportCount = vp.scissorCount = 1;
+      VkPipelineRasterizationStateCreateInfo rs{
+         VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+      rs.lineWidth = 1.0f;
+      VkPipelineMultisampleStateCreateInfo ms{
+         VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+      ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+      VkPipelineColorBlendAttachmentState attachments[2]{};
+      attachments[0].colorWriteMask = attachments[1].colorWriteMask = 0xf;
+      VkPipelineColorBlendStateCreateInfo blend{
+         VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+      blend.attachmentCount = 2;
+      blend.pAttachments = attachments;
+      /* A dynamic rasterizer discard makes a pipeline of two executables, the
+       * base one and the one that discards, which are two sets of shaders. */
+      const VkDynamicState dynamic_states[] = {
+         VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+         VK_DYNAMIC_STATE_RASTERIZER_DISCARD_ENABLE};
+      VkPipelineDynamicStateCreateInfo dynamic{
+         VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+      dynamic.dynamicStateCount = dynamic_discard ? 3 : 2;
+      dynamic.pDynamicStates = dynamic_states;
+      const VkFormat formats[2] = {kColorFormat, kColorFormat};
+      VkPipelineRenderingCreateInfo rendering{
+         VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO};
+      rendering.colorAttachmentCount = 2;
+      rendering.pColorAttachmentFormats = formats;
+      VkGraphicsPipelineCreateInfo info{
+         VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+      info.pNext = &rendering;
+      info.flags = flags;
+      info.stageCount = 2;
+      info.pStages = stages;
+      info.pVertexInputState = &vi;
+      info.pInputAssemblyState = &ia;
+      info.pViewportState = &vp;
+      info.pRasterizationState = &rs;
+      info.pMultisampleState = &ms;
+      info.pColorBlendState = &blend;
+      info.pDynamicState = &dynamic;
+      info.layout = graphics_layout;
+      return vkCreateGraphicsPipelines(device, cache, 1, &info, nullptr,
+                                       pipeline);
+   };
+
+   auto create_compute = [&](unsigned index, VkPipelineCache cache,
+                             VkPipelineCreateFlags flags,
+                             VkPipeline *pipeline) {
+      int variant = kFirstVariant + variant_base + int(index);
+      VkSpecializationMapEntry entry{0, 0, sizeof(variant)};
+      VkSpecializationInfo specialization{1, &entry, sizeof(variant),
+                                          &variant};
+      VkComputePipelineCreateInfo info{
+         VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+      info.flags = flags;
+      info.stage.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+      info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+      info.stage.module = compute_module;
+      info.stage.pName = "main";
+      info.stage.pSpecializationInfo = &specialization;
+      info.layout = compute_layout;
+      return vkCreateComputePipelines(device, cache, 1, &info, nullptr,
+                                      pipeline);
+   };
+
+   VkCommandPool pool = VK_NULL_HANDLE;
+   VkCommandBuffer command = VK_NULL_HANDLE;
+   kk_test_command_buffer(&t, 0, &pool, &command);
+
+   /* The MSL the shaders of a pipeline hold, read from a command buffer that
+    * has bound it. */
+   auto msl_of = [&](VkPipeline pipeline, VkPipelineBindPoint bind_point) {
+      result = vkResetCommandPool(device, pool, 0);
+      require(result == VK_SUCCESS, "reset command pool", result);
+      VkCommandBufferBeginInfo begin{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      result = vkBeginCommandBuffer(command, &begin);
+      require(result == VK_SUCCESS, "begin command", result);
+      vkCmdBindPipeline(command, bind_point, pipeline);
+      kk_test_msl_stats stats;
+      kk_test_bound_msl(command, &stats);
+      result = vkEndCommandBuffer(command);
+      require(result == VK_SUCCESS, "end command", result);
+      return stats;
+   };
+
+   struct Created {
+      std::vector<VkPipeline> graphics;
+      std::vector<VkPipeline> compute;
+      std::vector<kk_test_msl_stats> graphics_msl;
+      std::vector<kk_test_msl_stats> compute_msl;
+      std::vector<double> create_us;
+      std::vector<double> compute_us;
+   };
+   auto destroy = [&](Created &created) {
+      for (VkPipeline pipeline : created.graphics)
+         vkDestroyPipeline(device, pipeline, nullptr);
+      for (VkPipeline pipeline : created.compute)
+         vkDestroyPipeline(device, pipeline, nullptr);
+      created = Created{};
+   };
+   /* Creates `count` graphics and `count` compute pipelines. */
+   auto create_all = [&](VkPipelineCache cache, VkPipelineCreateFlags flags,
+                         VkResult *first_failure) {
+      Created created;
+      *first_failure = VK_SUCCESS;
+      for (unsigned i = 0; i < count; ++i) {
+         VkPipeline pipeline = VK_NULL_HANDLE;
+         auto start = Clock::now();
+         VkResult r = create_graphics(i, cache, flags, &pipeline);
+         created.create_us.push_back(microseconds(start, Clock::now()));
+         if (r != VK_SUCCESS) {
+            *first_failure = r;
+            continue;
+         }
+         created.graphics.push_back(pipeline);
+         created.graphics_msl.push_back(
+            msl_of(pipeline, VK_PIPELINE_BIND_POINT_GRAPHICS));
+      }
+      for (unsigned i = 0; i < count; ++i) {
+         VkPipeline pipeline = VK_NULL_HANDLE;
+         auto start = Clock::now();
+         VkResult r = create_compute(i, cache, flags, &pipeline);
+         created.compute_us.push_back(microseconds(start, Clock::now()));
+         if (r != VK_SUCCESS) {
+            *first_failure = r;
+            continue;
+         }
+         created.compute.push_back(pipeline);
+         created.compute_msl.push_back(
+            msl_of(pipeline, VK_PIPELINE_BIND_POINT_COMPUTE));
+      }
+      return created;
+   };
+   auto totals = [](const Created &created, uint64_t *resident,
+                    uint64_t *text, uint64_t *heap, bool *packed) {
+      *resident = *text = *heap = 0;
+      *packed = true;
+      for (const auto *list : {&created.graphics_msl, &created.compute_msl}) {
+         for (const kk_test_msl_stats &stats : *list) {
+            *resident += kk_test_msl_resident_bytes(&stats);
+            *text += kk_test_msl_text_bytes(&stats);
+            *heap += kk_test_msl_heap_bytes(&stats);
+            *packed &= kk_test_msl_all_packed(&stats);
+         }
+      }
+   };
+   auto cache_data = [&](VkPipelineCache cache, double *microseconds_out) {
+      size_t size = 0;
+      auto start = Clock::now();
+      result = vkGetPipelineCacheData(device, cache, &size, nullptr);
+      require(result == VK_SUCCESS, "cache size", result);
+      std::vector<uint8_t> data(size);
+      result = vkGetPipelineCacheData(device, cache, &size, data.data());
+      require(result == VK_SUCCESS, "cache data", result);
+      if (microseconds_out)
+         *microseconds_out = microseconds(start, Clock::now());
+      data.resize(size);
+      return data;
+   };
+   auto load_cache = [&](const std::vector<uint8_t> &data) {
+      VkPipelineCacheCreateInfo info{
+         VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+      info.initialDataSize = data.size();
+      info.pInitialData = data.data();
+      VkPipelineCache cache = VK_NULL_HANDLE;
+      result = vkCreatePipelineCache(device, &info, nullptr, &cache);
+      require(result == VK_SUCCESS, "load cache", result);
+      return cache;
+   };
+
+   /* The variants: a render pass that binds only the first attachment, which
+    * a pipeline that declares two builds its Metal pipeline for at its first
+    * draw. */
+   VkImage image = VK_NULL_HANDLE;
+   {
+      VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+      info.imageType = VK_IMAGE_TYPE_2D;
+      info.format = kColorFormat;
+      info.extent = {1, 1, 1};
+      info.mipLevels = 1;
+      info.arrayLayers = 1;
+      info.samples = VK_SAMPLE_COUNT_1_BIT;
+      info.tiling = VK_IMAGE_TILING_OPTIMAL;
+      info.usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                   VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+      result = vkCreateImage(device, &info, nullptr, &image);
+      require(result == VK_SUCCESS, "create image", result);
+   }
+   VkDeviceMemory image_memory = kk_test_image_memory(&t, image, 0);
+   VkImageView view = kk_test_image_view(&t, image, VK_IMAGE_VIEW_TYPE_2D,
+                                         kColorFormat,
+                                         VK_IMAGE_ASPECT_COLOR_BIT, 0, 1);
+   VkBuffer readback = VK_NULL_HANDLE;
+   VkDeviceMemory readback_memory = VK_NULL_HANDLE;
+   void *readback_data = nullptr;
+   kk_test_buffer(&t, 4, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                  KK_TEST_HOST_MEMORY, &readback, &readback_memory,
+                  &readback_data);
+
+   /* Draws once with only the first attachment bound and returns how long the
+    * draw took to record, which is when the variant is built, and what the
+    * attachment holds. */
+   auto draw_variant = [&](VkPipeline pipeline, double *record_us,
+                           uint8_t pixel[4]) {
+      result = vkResetCommandPool(device, pool, 0);
+      require(result == VK_SUCCESS, "reset command pool", result);
+      VkCommandBufferBeginInfo begin{
+         VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+      begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+      result = vkBeginCommandBuffer(command, &begin);
+      require(result == VK_SUCCESS, "begin command", result);
+
+      const VkImageSubresourceRange range{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0,
+                                          1};
+      VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+      barrier.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+      barrier.newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+      barrier.image = image;
+      barrier.subresourceRange = range;
+      vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                           VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0,
+                           0, nullptr, 0, nullptr, 1, &barrier);
+
+      VkRenderingAttachmentInfo attachments[2]{};
+      attachments[0].sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
+      attachments[0].imageView = view;
+      attachments[0].imageLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      attachments[0].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+      attachments[0].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      attachments[1].sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO;
+      const VkRect2D area{{0, 0}, {1, 1}};
+      VkRenderingInfo render_info{VK_STRUCTURE_TYPE_RENDERING_INFO};
+      render_info.renderArea = area;
+      render_info.layerCount = 1;
+      render_info.colorAttachmentCount = 2;
+      render_info.pColorAttachments = attachments;
+      vkCmdBeginRendering(command, &render_info);
+      vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      const VkViewport viewport{0, 0, 1, 1, 0, 1};
+      vkCmdSetViewport(command, 0, 1, &viewport);
+      vkCmdSetScissor(command, 0, 1, &area);
+      auto start = Clock::now();
+      vkCmdDraw(command, 3, 1, 0, 0);
+      *record_us = microseconds(start, Clock::now());
+      vkCmdEndRendering(command);
+
+      barrier.srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+      barrier.oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+      vkCmdPipelineBarrier(command,
+                           VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0,
+                           nullptr, 1, &barrier);
+      VkBufferImageCopy region{};
+      region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+      region.imageExtent = {1, 1, 1};
+      vkCmdCopyImageToBuffer(command, image,
+                             VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback,
+                             1, &region);
+      result = vkEndCommandBuffer(command);
+      require(result == VK_SUCCESS, "end command", result);
+      result = kk_test_submit_and_wait(&t, command, 20000000000ull);
+      require(result == VK_SUCCESS, "draw retired", result);
+      std::memcpy(pixel, readback_data, 4);
+   };
+   auto check_variants = [&](const Created &created, const char *what,
+                             std::vector<double> *times) {
+      for (VkPipeline pipeline : created.graphics) {
+         double record_us = 0;
+         uint8_t pixel[4];
+         draw_variant(pipeline, &record_us, pixel);
+         if (times)
+            times->push_back(record_us);
+         if (pixel[0] != 255 || pixel[1] != 0 || pixel[2] != 0 ||
+             pixel[3] != 255) {
+            std::fprintf(stderr,
+                         "%s: variant drew (%u, %u, %u, %u), expected "
+                         "(255, 0, 0, 255)\n",
+                         what, pixel[0], pixel[1], pixel[2], pixel[3]);
+            std::exit(1);
+         }
+      }
+   };
+
+   const uint64_t heap_before = kk_test_heap_in_use();
+   const uint64_t footprint_before = kk_test_footprint();
+
+   VkPipelineCache cache = VK_NULL_HANDLE;
+   {
+      VkPipelineCacheCreateInfo info{
+         VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+      result = vkCreatePipelineCache(device, &info, nullptr, &cache);
+      require(result == VK_SUCCESS, "create cache", result);
+   }
+
+   VkResult failure = VK_SUCCESS;
+   Created created = create_all(cache, 0, &failure);
+   require(failure == VK_SUCCESS, "create pipelines", failure);
+   const uint64_t heap_after = kk_test_heap_in_use();
+   const uint64_t footprint_after = kk_test_footprint();
+
+   uint64_t resident, text, heap, packed;
+   bool all_packed;
+   totals(created, &resident, &text, &heap, &all_packed);
+   packed = all_packed;
+
+   double get_us = 0;
+   std::vector<uint8_t> blob = cache_data(cache, &get_us);
+
+   if (bench) {
+      std::vector<double> variant_us;
+      check_variants(created, "created pipeline", &variant_us);
+
+      const uint64_t before_load_heap = kk_test_heap_in_use();
+      const uint64_t before_load_footprint = kk_test_footprint();
+      auto start = Clock::now();
+      VkPipelineCache loaded = load_cache(blob);
+      const double load_us = microseconds(start, Clock::now());
+      const uint64_t after_load_heap = kk_test_heap_in_use();
+      const uint64_t after_load_footprint = kk_test_footprint();
+      VkResult hit_failure = VK_SUCCESS;
+      Created hits = create_all(
+         loaded, VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT,
+         &hit_failure);
+      const uint64_t hit_heap = kk_test_heap_in_use();
+
+      std::printf("metric pipelines %u\n", count);
+      std::printf("metric msl_resident_bytes %llu\n",
+                  (unsigned long long)resident);
+      std::printf("metric msl_text_bytes %llu\n", (unsigned long long)text);
+      std::printf("metric msl_heap_bytes %llu\n", (unsigned long long)heap);
+      std::printf("metric msl_packed %llu\n", (unsigned long long)packed);
+      std::printf("metric heap_growth_bytes %lld\n",
+                  (long long)(heap_after - heap_before));
+      std::printf("metric footprint_growth_bytes %lld\n",
+                  (long long)(footprint_after - footprint_before));
+      std::vector<double> graphics_us(created.create_us.begin(),
+                                      created.create_us.end());
+      std::printf("metric create_us_median %.1f\n",
+                  percentile(graphics_us, 0.5));
+      std::printf("metric create_us_p95 %.1f\n",
+                  percentile(graphics_us, 0.95));
+      std::printf("metric compute_create_us_median %.1f\n",
+                  percentile(created.compute_us, 0.5));
+      std::printf("metric compute_create_us_p95 %.1f\n",
+                  percentile(created.compute_us, 0.95));
+      std::printf("metric cache_blob_bytes %zu\n", blob.size());
+      std::printf("metric cache_get_us %.1f\n", get_us);
+      std::printf("metric cache_load_us %.1f\n", load_us);
+      std::printf("metric cache_load_heap_bytes %lld\n",
+                  (long long)(after_load_heap - before_load_heap));
+      std::printf("metric cache_load_footprint_bytes %lld\n",
+                  (long long)(after_load_footprint - before_load_footprint));
+      std::printf("metric cache_hit_result %d\n", int(hit_failure));
+      std::printf("metric cache_hit_create_us_median %.1f\n",
+                  percentile(hits.create_us, 0.5));
+      std::printf("metric heap_after_cache_hits_bytes %lld\n",
+                  (long long)(hit_heap - after_load_heap));
+      std::printf("metric variant_us_median %.1f\n",
+                  percentile(variant_us, 0.5));
+      std::printf("metric variant_us_p95 %.1f\n",
+                  percentile(variant_us, 0.95));
+
+      destroy(hits);
+      vkDestroyPipelineCache(device, loaded, nullptr);
+   } else {
+      /* Every source is the compressed one, and the heap holds the compressed
+       * size for it: the bytes the shader reports, and the heap's rounding of
+       * the block, which is a few hundred bytes at most. */
+      require(all_packed, "every MSL source of a created pipeline is packed");
+      uint64_t entries = 0;
+      for (const auto *list : {&created.graphics_msl, &created.compute_msl}) {
+         for (const kk_test_msl_stats &stats : *list) {
+            entries += stats.count;
+            for (uint32_t i = 0; i < stats.count; ++i) {
+               const kk_test_msl_entry &entry = stats.entries[i];
+               if (entry.resident_bytes != entry.recompressed_bytes) {
+                  std::fprintf(stderr,
+                               "resident %u bytes, the text compresses to %u "
+                               "(of %u)\n",
+                               entry.resident_bytes, entry.recompressed_bytes,
+                               entry.text_bytes);
+                  return 1;
+               }
+            }
+         }
+      }
+      std::printf("%llu MSL sources hold %llu bytes of the %llu of their "
+                  "text; the heap holds %llu for them\n",
+                  (unsigned long long)entries, (unsigned long long)resident,
+                  (unsigned long long)text, (unsigned long long)heap);
+      require(resident * 3 < text, "the resident MSL is a third of the text");
+      require(heap >= resident && heap <= resident + entries * 512,
+              "the heap holds the compressed size for the MSL");
+
+      /* The shaders of a pipeline that came from the cache. */
+      require(blob.size() * 4 < text * 3,
+              "the pipeline cache is under three quarters of the text");
+      std::printf("pipeline cache: %zu bytes\n", blob.size());
+
+      VkPipelineCache loaded = load_cache(blob);
+      VkResult hit_failure = VK_SUCCESS;
+      Created hits = create_all(
+         loaded, VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT,
+         &hit_failure);
+      require(hit_failure == VK_SUCCESS,
+              "every pipeline is created from the loaded cache", hit_failure);
+      uint64_t hit_resident, hit_text, hit_heap;
+      bool hit_packed;
+      totals(hits, &hit_resident, &hit_text, &hit_heap, &hit_packed);
+      require(hit_packed, "the loaded shaders keep their MSL packed");
+      require(hit_resident == resident && hit_text == text,
+              "the loaded shaders hold what the created ones did");
+      for (unsigned i = 0; i < count; ++i) {
+         const kk_test_msl_stats &a = created.graphics_msl[i];
+         const kk_test_msl_stats &b = hits.graphics_msl[i];
+         require(a.count == b.count, "the loaded pipeline has the same MSL");
+         for (uint32_t e = 0; e < a.count; ++e)
+            require(a.entries[e].text_hash == b.entries[e].text_hash,
+                    "the loaded graphics MSL is the text that was cached");
+         const kk_test_msl_stats &ca = created.compute_msl[i];
+         const kk_test_msl_stats &cb = hits.compute_msl[i];
+         require(ca.count == cb.count, "the loaded compute has the same MSL");
+         for (uint32_t e = 0; e < ca.count; ++e)
+            require(ca.entries[e].text_hash == cb.entries[e].text_hash,
+                    "the loaded compute MSL is the text that was cached");
+      }
+      require(cache_data(loaded, nullptr).size() == blob.size(),
+              "the loaded cache writes the same bytes back");
+
+      /* Variants build from the packed text, in the pipelines that were
+       * compiled here and in those that were loaded. */
+      check_variants(created, "created pipeline", nullptr);
+      check_variants(hits, "loaded pipeline", nullptr);
+      std::printf("variants of %zu created and %zu loaded pipelines "
+                  "rendered\n",
+                  created.graphics.size(), hits.graphics.size());
+
+      /* A cache cut short or damaged never hands out a broken shader: its
+       * pipelines compile again, or report that they must. */
+      std::vector<uint8_t> cut(blob.begin(),
+                               blob.begin() + (blob.size() * 3) / 5);
+      VkPipelineCache cut_cache = load_cache(cut);
+      VkResult cut_failure = VK_SUCCESS;
+      Created from_cut = create_all(cut_cache, 0, &cut_failure);
+      require(cut_failure == VK_SUCCESS, "a cut cache compiles the rest",
+              cut_failure);
+      destroy(from_cut);
+      vkDestroyPipelineCache(device, cut_cache, nullptr);
+
+      destroy(hits);
+      vkDestroyPipelineCache(device, loaded, nullptr);
+
+      /* The shaders of the executables a pipeline switches between are packed
+       * too, and a cache carries them with the pipeline. */
+      VkPipelineCache raster_cache = VK_NULL_HANDLE;
+      {
+         VkPipelineCacheCreateInfo info{
+            VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+         result = vkCreatePipelineCache(device, &info, nullptr,
+                                        &raster_cache);
+         require(result == VK_SUCCESS, "create raster cache", result);
+      }
+      VkPipeline raster = VK_NULL_HANDLE;
+      result = create_graphics(100, raster_cache, 0, &raster, true);
+      require(result == VK_SUCCESS, "dynamic discard pipeline", result);
+      const kk_test_msl_stats raster_msl =
+         msl_of(raster, VK_PIPELINE_BIND_POINT_GRAPHICS);
+      unsigned raster_entries = 0;
+      for (uint32_t i = 0; i < raster_msl.count; ++i)
+         raster_entries += raster_msl.entries[i].is_raster_variant;
+      require(raster_entries > 0, "the pipeline has raster variant shaders");
+      require(kk_test_msl_all_packed(&raster_msl),
+              "the MSL of the raster variants is packed");
+      std::vector<uint8_t> raster_blob = cache_data(raster_cache, nullptr);
+      VkPipelineCache raster_loaded = load_cache(raster_blob);
+      VkPipeline raster_hit = VK_NULL_HANDLE;
+      result = create_graphics(
+         100, raster_loaded,
+         VK_PIPELINE_CREATE_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT,
+         &raster_hit, true);
+      require(result == VK_SUCCESS, "dynamic discard pipeline from cache",
+              result);
+      const kk_test_msl_stats hit_msl =
+         msl_of(raster_hit, VK_PIPELINE_BIND_POINT_GRAPHICS);
+      require(hit_msl.count == raster_msl.count &&
+                 kk_test_msl_all_packed(&hit_msl),
+              "the loaded raster variants are packed");
+      for (uint32_t i = 0; i < raster_msl.count; ++i)
+         require(raster_msl.entries[i].text_hash ==
+                    hit_msl.entries[i].text_hash,
+                 "the loaded raster variants hold the text that was cached");
+      std::printf("%u raster variant sources packed\n", raster_entries);
+      vkDestroyPipeline(device, raster_hit, nullptr);
+      vkDestroyPipeline(device, raster, nullptr);
+      vkDestroyPipelineCache(device, raster_loaded, nullptr);
+      vkDestroyPipelineCache(device, raster_cache, nullptr);
+      std::printf("MSL packing passed\n");
+   }
+
+   destroy(created);
+   vkDestroyPipelineCache(device, cache, nullptr);
+   vkDestroyImageView(device, view, nullptr);
+   vkDestroyImage(device, image, nullptr);
+   vkFreeMemory(device, image_memory, nullptr);
+   vkDestroyBuffer(device, readback, nullptr);
+   vkFreeMemory(device, readback_memory, nullptr);
+   vkDestroyCommandPool(device, pool, nullptr);
+   vkDestroyPipelineLayout(device, compute_layout, nullptr);
+   vkDestroyDescriptorSetLayout(device, set_layout, nullptr);
+   vkDestroyPipelineLayout(device, graphics_layout, nullptr);
+   vkDestroyShaderModule(device, compute_module, nullptr);
+   vkDestroyShaderModule(device, fragment_module, nullptr);
+   vkDestroyShaderModule(device, vertex_module, nullptr);
+   kk_test_destroy(&t);
+   return 0;
+}
