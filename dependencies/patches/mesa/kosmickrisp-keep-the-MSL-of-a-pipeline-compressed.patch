diff --git a/src/kosmickrisp/vulkan/kk_msl_pack.c b/src/kosmickrisp/vulkan/kk_msl_pack.c
new file mode 100644
index 0000000000000000000000000000000000000000..59a2546b4aefefa0ca3553c7b28e2295dc229f48
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_msl_pack.c
@@ -0,0 +1,241 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "kk_msl_pack.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "util/ralloc.h"
+
+#if defined(__APPLE__)
+#include <compression.h>
+#endif
+
+/* LZFSE gives MSL a fifth of its size (LZ4 a third) and decompresses at over
+ * a GB/s, so a build from the compressed text costs a few tenths of a
+ * millisecond more than one from the plain text. */
+#if defined(__APPLE__)
+#define KK_MSL_CODEC KK_MSL_CODEC_LZFSE
+#else
+#define KK_MSL_CODEC KK_MSL_CODEC_STORED
+#endif
+
+/* Compresses text[0, size) into a buffer of exactly the compressed size, or
+ * returns NULL when the codec does not make it smaller. */
+static uint8_t *
+kk_msl_compress(const char *text, uint32_t size, uint32_t *packed_size)
+{
+#if defined(__APPLE__)
+   /* The codec writes at most `size - 1` bytes, because anything that does not
+    * fit is not worth keeping. */
+   if (size < 2)
+      return NULL;
+
+   uint8_t *buffer = malloc(size - 1);
+   if (buffer == NULL)
+      return NULL;
+
+   const size_t written = compression_encode_buffer(
+      buffer, size - 1, (const uint8_t *)text, size, NULL,
+      COMPRESSION_LZFSE);
+   if (written == 0) {
+      free(buffer);
+      return NULL;
+   }
+
+   /* The buffer is as large as the text.  Keep a block of exactly the
+    * compressed size, since holding the rest would defeat the purpose of
+    * compressing. */
+   uint8_t *packed = malloc(written);
+   if (packed != NULL) {
+      memcpy(packed, buffer, written);
+      *packed_size = written;
+   }
+   free(buffer);
+   return packed;
+#else
+   (void)text;
+   (void)size;
+   (void)packed_size;
+   return NULL;
+#endif
+}
+
+bool
+kk_msl_pack(struct msl_compile_data *data)
+{
+   if (data->code == NULL || data->packed != NULL)
+      return data->packed != NULL;
+
+   const size_t length = strlen(data->code) + 1;
+   if (length > KK_MSL_MAX_CODE_SIZE)
+      return false;
+
+   uint32_t packed_size = 0;
+   uint8_t *packed = kk_msl_compress(data->code, length, &packed_size);
+   if (packed == NULL)
+      return false;
+
+   ralloc_free(data->code);
+   data->code = NULL;
+   data->packed = packed;
+   data->packed_size = packed_size;
+   data->code_size = length;
+   data->codec = KK_MSL_CODEC;
+   return true;
+}
+
+bool
+kk_msl_pack_copy(struct msl_compile_data *dst,
+                 const struct msl_compile_data *src)
+{
+   if (dst->code == NULL || dst->packed != NULL || src->packed == NULL)
+      return false;
+
+   /* The same text compresses to the same bytes, so the sizes tell the texts
+    * apart cheaply; the caller says they are the same text. */
+   if (strlen(dst->code) + 1 != src->code_size)
+      return false;
+
+   uint8_t *packed = malloc(src->packed_size);
+   if (packed == NULL)
+      return false;
+   memcpy(packed, src->packed, src->packed_size);
+
+   ralloc_free(dst->code);
+   dst->code = NULL;
+   dst->packed = packed;
+   dst->packed_size = src->packed_size;
+   dst->code_size = src->code_size;
+   dst->codec = src->codec;
+   return true;
+}
+
+bool
+kk_msl_adopt(struct msl_compile_data *data, enum kk_msl_codec codec,
+             const void *bytes, uint32_t packed_size, uint32_t code_size)
+{
+   if (codec >= KK_MSL_CODEC_COUNT || code_size < 1 ||
+       code_size > KK_MSL_MAX_CODE_SIZE || packed_size < 1 ||
+       packed_size > code_size)
+      return false;
+   if (codec == KK_MSL_CODEC_STORED && packed_size != code_size)
+      return false;
+#if !defined(__APPLE__)
+   if (codec != KK_MSL_CODEC_STORED)
+      return false;
+#endif
+
+   if (codec == KK_MSL_CODEC_STORED) {
+      /* The text itself is no smaller packed than plain, so keep it plain. */
+      char *code = ralloc_size(NULL, code_size);
+      if (code == NULL)
+         return false;
+      memcpy(code, bytes, code_size);
+      if (code[code_size - 1] != '\0') {
+         ralloc_free(code);
+         return false;
+      }
+      data->code = code;
+      return true;
+   }
+
+   uint8_t *packed = malloc(packed_size);
+   if (packed == NULL)
+      return false;
+   memcpy(packed, bytes, packed_size);
+
+   data->packed = packed;
+   data->packed_size = packed_size;
+   data->code_size = code_size;
+   data->codec = codec;
+   return true;
+}
+
+bool
+kk_msl_has_text(const struct msl_compile_data *data)
+{
+   return data->code != NULL || data->packed != NULL;
+}
+
+const char *
+kk_msl_text(const struct msl_compile_data *data, char **scratch)
+{
+   *scratch = NULL;
+   if (data->code != NULL)
+      return data->code;
+   if (data->packed == NULL)
+      return NULL;
+
+#if defined(__APPLE__)
+   if (data->codec != KK_MSL_CODEC_LZFSE)
+      return NULL;
+
+   char *text = malloc(data->code_size);
+   if (text == NULL)
+      return NULL;
+
+   const size_t read = compression_decode_buffer(
+      (uint8_t *)text, data->code_size, data->packed, data->packed_size, NULL,
+      COMPRESSION_LZFSE);
+   /* The terminator is part of the text, and a text that is not terminated is
+    * not one this driver compressed. */
+   if (read != data->code_size || text[data->code_size - 1] != '\0') {
+      free(text);
+      return NULL;
+   }
+
+   *scratch = text;
+   return text;
+#else
+   return NULL;
+#endif
+}
+
+void
+kk_msl_text_release(char *scratch)
+{
+   free(scratch);
+}
+
+size_t
+kk_msl_resident_bytes(const struct msl_compile_data *data)
+{
+   if (data->packed != NULL)
+      return data->packed_size;
+   if (data->code != NULL)
+      return strlen(data->code) + 1;
+   return 0;
+}
+
+size_t
+kk_msl_text_bytes(const struct msl_compile_data *data)
+{
+   if (data->packed != NULL)
+      return data->code_size;
+   if (data->code != NULL)
+      return strlen(data->code) + 1;
+   return 0;
+}
+
+void
+kk_msl_drop(struct msl_compile_data *data)
+{
+   ralloc_free(data->code);
+   data->code = NULL;
+   free(data->packed);
+   data->packed = NULL;
+   data->packed_size = 0;
+   data->code_size = 0;
+}
+
+void
+kk_msl_finish(struct msl_compile_data *data)
+{
+   kk_msl_drop(data);
+   ralloc_free(data->entrypoint_name);
+   data->entrypoint_name = NULL;
+}
diff --git a/src/kosmickrisp/vulkan/kk_msl_pack.h b/src/kosmickrisp/vulkan/kk_msl_pack.h
