index 0000000000000000000000000000000000000000..116e3f3cb4b3ed4fde9e440832d10bac8fe8ac6f
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_msl_pack.h
@@ -0,0 +1,95 @@
+/*
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef KK_MSL_PACK_H
+#define KK_MSL_PACK_H 1
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* The MSL source of one Metal function and the name of the entrypoint to build
+ * it from.
+ *
+ * A shader needs its MSL again only to build another Metal pipeline from it
+ * (a render pass that binds fewer attachments than the pipeline declares) and
+ * to write it to a pipeline cache, and the text is the largest thing a
+ * pipeline keeps: tens of KiB for a small shader, a third of a MiB for a large
+ * one.  So a finished shader holds it compressed.  Exactly one of three forms
+ * is live: the plain text in `code`, the compressed text in `packed`, or
+ * neither once the owner dropped it.  kk_msl_text() gives the text of either
+ * of the first two.
+ */
+struct msl_compile_data {
+   char *code;
+   char *entrypoint_name;
+   /* malloc'd, so the heap accounts exactly for the bytes it holds. */
+   uint8_t *packed;
+   /* Bytes of `packed`, and of the text with its terminator. */
+   uint32_t packed_size;
+   uint32_t code_size;
+   /* An enum kk_msl_codec. */
+   uint8_t codec;
+};
+
+/* The serialized form of a text carries its codec, so the one a build picks
+ * can change without making the bytes of an older one unreadable. */
+enum kk_msl_codec {
+   /* The bytes are the text itself. */
+   KK_MSL_CODEC_STORED = 0,
+   KK_MSL_CODEC_LZFSE = 1,
+   KK_MSL_CODEC_COUNT,
+};
+
+/* The most a text may hold, which is what a cache can ask a driver to hold. */
+#define KK_MSL_MAX_CODE_SIZE (256u << 20)
+
+/* Replaces the plain text by its compressed form when that is smaller.  The
+ * text stays when it is not, or when memory is short.  Returns whether the
+ * text is now compressed. */
+bool kk_msl_pack(struct msl_compile_data *data);
+
+/* Gives `dst`, whose plain text is the same as the compressed text of `src`, a
+ * copy of that compressed text instead of compressing it again.  Returns
+ * whether it did, and otherwise leaves `dst` alone. */
+bool kk_msl_pack_copy(struct msl_compile_data *dst,
+                      const struct msl_compile_data *src);
+
+/* Adopts compressed bytes read from a cache without decompressing them.  The
+ * bytes are copied.  Returns false when the sizes cannot be a text or memory
+ * is short. */
+bool kk_msl_adopt(struct msl_compile_data *data, enum kk_msl_codec codec,
+                  const void *bytes, uint32_t packed_size,
+                  uint32_t code_size);
+
+/* Whether the data holds a text in either form. */
+bool kk_msl_has_text(const struct msl_compile_data *data);
+
+/* The plain text, or NULL when there is none or when decompressing it ran out
+ * of memory or found the bytes corrupt.  A compressed text is decompressed into
+ * a temporary copy, which `*scratch` points to and the caller releases with
+ * kk_msl_text_release() once it is done with the returned text. */
+const char *kk_msl_text(const struct msl_compile_data *data, char **scratch);
+void kk_msl_text_release(char *scratch);
+
+/* The bytes of the text the data holds now, and of the text it stands for. */
+size_t kk_msl_resident_bytes(const struct msl_compile_data *data);
+size_t kk_msl_text_bytes(const struct msl_compile_data *data);
+
+/* Frees the text in whichever form it is held; the entrypoint stays. */
+void kk_msl_drop(struct msl_compile_data *data);
+
+/* Frees the text and the entrypoint. */
+void kk_msl_finish(struct msl_compile_data *data);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* KK_MSL_PACK_H */
