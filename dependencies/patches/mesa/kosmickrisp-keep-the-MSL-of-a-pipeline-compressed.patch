diff --git a/src/kosmickrisp/vulkan/tests/msl_packing_state.c b/src/kosmickrisp/vulkan/tests/msl_packing_state.c
new file mode 100644
index 0000000000000000000000000000000000000000..d95d9dc43bab01b199e75e12a87ce4cd5c83e990
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/msl_packing_state.c
@@ -0,0 +1,176 @@
+/* SPDX-License-Identifier: MIT */
+#include "msl_packing_state.h"
+
+#include <compression.h>
+#include <malloc/malloc.h>
+#include <mach/mach.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "kosmickrisp/vulkan/kk_cmd_buffer.h"
+#include "kosmickrisp/vulkan/kk_shader.h"
+
+/* The driver gets this test's checks on a tree that does not compress yet, for
+ * the comparison the measurements need: there every entry is plain. */
+#if defined(__has_include)
+#if __has_include("kosmickrisp/vulkan/kk_msl_pack.h")
+#define KK_TEST_HAS_PACKED 1
+#endif
+#endif
+
+static uint64_t
+hash_text(const char *text, size_t size)
+{
+   uint64_t hash = 1469598103934665603ull;
+   for (size_t i = 0; i < size; i++)
+      hash = (hash ^ (uint8_t)text[i]) * 1099511628211ull;
+   return hash;
+}
+
+/* What the text of `size` bytes compresses to, or `size` when it does not
+ * get smaller. */
+static uint32_t
+compressed_size(const char *text, size_t size)
+{
+   uint8_t *buffer = malloc(size);
+   size_t written = compression_encode_buffer(
+      buffer, size, (const uint8_t *)text, size, NULL, COMPRESSION_LZFSE);
+   free(buffer);
+   return written != 0 ? written : size;
+}
+
+static void
+add_entry(struct kk_test_msl_stats *out, const struct msl_compile_data *data,
+          bool raster_variant)
+{
+   if (data->code == NULL
+#ifdef KK_TEST_HAS_PACKED
+       && data->packed == NULL
+#endif
+      )
+      return;
+   if (out->count == KK_TEST_MAX_MSL_ENTRIES)
+      abort();
+
+   struct kk_test_msl_entry *entry = &out->entries[out->count++];
+   memset(entry, 0, sizeof(*entry));
+   entry->is_raster_variant = raster_variant;
+
+#ifdef KK_TEST_HAS_PACKED
+   if (data->packed != NULL) {
+      entry->packed = true;
+      entry->text_bytes = data->code_size;
+      entry->resident_bytes = data->packed_size;
+      entry->heap_bytes = malloc_size(data->packed);
+      char *text = malloc(data->code_size);
+      size_t read = compression_decode_buffer(
+         (uint8_t *)text, data->code_size, data->packed, data->packed_size,
+         NULL, COMPRESSION_LZFSE);
+      if (read != data->code_size)
+         abort();
+      entry->text_hash = hash_text(text, read);
+      entry->recompressed_bytes = compressed_size(text, read);
+      free(text);
+      return;
+   }
+#endif
+
+   entry->text_bytes = entry->resident_bytes = entry->heap_bytes =
+      strlen(data->code) + 1;
+   entry->text_hash = hash_text(data->code, entry->text_bytes);
+   entry->recompressed_bytes = compressed_size(data->code, entry->text_bytes);
+}
+
+static void
+add_shader(struct kk_test_msl_stats *out, const struct kk_shader *shader,
+           bool raster_variant)
+{
+   for (uint32_t stage = 0; stage < MESA_SHADER_STAGES; stage++)
+      add_entry(out, &shader->msl_data[stage], raster_variant);
+   add_entry(out, &shader->transform_feedback_pre_gs_msl, raster_variant);
+   add_entry(out, &shader->line_raster_materialize_msl, raster_variant);
+   add_entry(out, &shader->line_stipple_prefix_msl, raster_variant);
+   add_entry(out, &shader->geometry_main_msl, raster_variant);
+   add_entry(out, &shader->geometry_count_msl, raster_variant);
+   add_entry(out, &shader->geometry_pre_gs_msl, raster_variant);
+}
+
+void
+kk_test_bound_msl(VkCommandBuffer command, struct kk_test_msl_stats *out)
+{
+   const struct kk_cmd_buffer *cmd = kk_cmd_buffer_from_handle(command);
+   memset(out, 0, sizeof(*out));
+   for (uint32_t stage = 0; stage < MESA_SHADER_STAGES; stage++) {
+      const struct kk_shader *shader = cmd->state.shaders[stage];
+      if (shader == NULL)
+         continue;
+      add_shader(out, shader, false);
+      if (stage != MESA_SHADER_VERTEX)
+         continue;
+      for (uint32_t variant = 0; variant < KK_RASTER_VARIANT_COUNT;
+           variant++) {
+         for (uint32_t child = 0; child < MESA_SHADER_STAGES; child++) {
+            const struct kk_shader *raster =
+               shader->raster_variant_shaders[variant][child];
+            if (raster != NULL)
+               add_shader(out, raster, true);
+         }
+      }
+   }
+}
+
+uint64_t
+kk_test_msl_resident_bytes(const struct kk_test_msl_stats *stats)
+{
+   uint64_t bytes = 0;
+   for (uint32_t i = 0; i < stats->count; i++)
+      bytes += stats->entries[i].resident_bytes;
+   return bytes;
+}
+
+uint64_t
+kk_test_msl_text_bytes(const struct kk_test_msl_stats *stats)
+{
+   uint64_t bytes = 0;
+   for (uint32_t i = 0; i < stats->count; i++)
+      bytes += stats->entries[i].text_bytes;
+   return bytes;
+}
+
+uint64_t
+kk_test_msl_heap_bytes(const struct kk_test_msl_stats *stats)
+{
+   uint64_t bytes = 0;
+   for (uint32_t i = 0; i < stats->count; i++)
+      bytes += stats->entries[i].heap_bytes;
+   return bytes;
+}
+
+bool
+kk_test_msl_all_packed(const struct kk_test_msl_stats *stats)
+{
+   for (uint32_t i = 0; i < stats->count; i++) {
+      if (!stats->entries[i].packed)
+         return false;
+   }
+   return stats->count > 0;
+}
+
+uint64_t
+kk_test_heap_in_use(void)
+{
+   malloc_statistics_t statistics;
+   malloc_zone_statistics(NULL, &statistics);
+   return statistics.size_in_use;
+}
+
+uint64_t
+kk_test_footprint(void)
+{
+   task_vm_info_data_t info;
+   mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+   if (task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&info,
+                 &count) != KERN_SUCCESS)
+      return 0;
+   return info.phys_footprint;
+}
