index 0000000000000000000000000000000000000000..da4287e7842daa20177c61c929c5456ae5dd09ea
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/msl_packing_shaders/pack.comp
@@ -0,0 +1,30 @@
+#version 450
+
+layout(local_size_x = 64) in;
+
+layout(constant_id = 0) const int variant = 0;
+
+layout(set = 0, binding = 0) buffer Data {
+   uint values[];
+};
+
+#define STEP(n)                                                               \
+   h = h * 1664525u + 1013904223u + uint(variant + n);                        \
+   h ^= h >> 13;                                                              \
+   h = (h << 7) | (h >> 25);                                                  \
+   h += h.wxyz;
+
+void main()
+{
+   uint id = gl_GlobalInvocationID.x;
+   uvec4 h = uvec4(id, id + 1u, id + 2u, id + 3u);
+   STEP(0)
+   STEP(1)
+   STEP(2)
+   STEP(3)
+   STEP(4)
+   STEP(5)
+   STEP(6)
+   STEP(7)
+   values[id] = h.x ^ h.y ^ h.z ^ h.w;
+}
