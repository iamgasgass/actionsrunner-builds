diff --git a/src/kosmickrisp/vulkan/tests/msl_packing_shaders/pack.frag b/src/kosmickrisp/vulkan/tests/msl_packing_shaders/pack.frag
new file mode 100644
index 0000000000000000000000000000000000000000..b4c8197666f669da43a2f3792133cdbedbf995ec
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/msl_packing_shaders/pack.frag
@@ -0,0 +1,38 @@
+#version 450
+
+/* Integer arithmetic the compiler cannot fold, so that the MSL of a pipeline
+ * is as large as a real shader's.  The specialization constant gives each
+ * pipeline text of its own. */
+layout(constant_id = 0) const int variant = 0;
+
+layout(location = 0) in vec4 color;
+layout(location = 0) out vec4 out0;
+layout(location = 1) out vec4 out1;
+
+#define STEP(n)                                                               \
+   h = h * 1664525u + 1013904223u + uint(variant + n);                        \
+   h ^= h >> 13;                                                              \
+   h = (h << 7) | (h >> 25);                                                  \
+   h += h.wxyz;
+
+void main()
+{
+   uvec4 h = uvec4(floatBitsToUint(color.x), floatBitsToUint(color.y),
+                   floatBitsToUint(color.z), floatBitsToUint(color.w));
+   STEP(0)
+   STEP(1)
+   STEP(2)
+   STEP(3)
+   STEP(4)
+   STEP(5)
+   STEP(6)
+   STEP(7)
+   STEP(8)
+   STEP(9)
+   STEP(10)
+   STEP(11)
+   /* No pixel hashes to these values, so the outputs are the constants. */
+   const bool never = h.x == 12345u && h.y == 67u && h.z == 89u;
+   out0 = never ? vec4(0.0, 0.0, 1.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
+   out1 = never ? vec4(0.0, 0.0, 1.0, 1.0) : vec4(0.0, 1.0, 0.0, 1.0);
+}
