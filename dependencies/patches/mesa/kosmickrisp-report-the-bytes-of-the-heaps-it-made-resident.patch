 /* TODO_KOSMICKRISP We should move this struct to the bridge side. */
 struct kk_image_layout;
@@ -20,7 +21,7 @@ mtl_heap *mtl_new_heap(mtl_device *device, uint64_t size,
 
 /* Utils */
 uint64_t mtl_heap_get_size(mtl_heap *heap);
-void mtl_heap_make_resident(mtl_device *device, mtl_heap *heap);
+bool mtl_heap_make_resident(mtl_device *device, mtl_heap *heap);
 
 /* Allocation from heap */
 mtl_buffer *mtl_new_buffer_with_length(mtl_heap *heap, uint64_t size_B,
diff --git a/src/kosmickrisp/bridge/mtl_heap.m b/src/kosmickrisp/bridge/mtl_heap.m
index a5212dacf2ff415388502d51b580b0db7bbc18d9..0294123601b4187793fa2a7d342ce218fe2d757f 100644
--- a/src/kosmickrisp/bridge/mtl_heap.m
+++ b/src/kosmickrisp/bridge/mtl_heap.m
@@ -41,8 +41,10 @@
 
 /* Commits the heap's pages now, through a residency set of its own, rather
  * than at the first submission of a queue whose set holds it. The pages stay
- * once the set ends its residency; only their eviction becomes possible. */
-void
+ * once the set ends its residency; only their eviction becomes possible.
+ * False when no residency set could be made, and the heap waits for that
+ * submission. */
+bool
 mtl_heap_make_resident(mtl_device *device, mtl_heap *heap)
 {
    @autoreleasepool {
@@ -53,12 +55,13 @@
       id<MTLResidencySet> set =
          [dev newResidencySetWithDescriptor:descriptor error:&error];
       if (set == nil)
-         return;
+         return false;
       [set addAllocation:(id<MTLHeap>)heap];
       [set commit];
       [set requestResidency];
       [set endResidency];
       [set release];
+      return true;
    }
 }
 
diff --git a/src/kosmickrisp/bridge/stubs/mtl_heap.c b/src/kosmickrisp/bridge/stubs/mtl_heap.c
