From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yi Xie <imxieyi@users.noreply.github.com>
Date: Tue, 10 Nov 2026 16:58:46 +0900
Subject: [PATCH] venus: refuse a render pass begin whose attachments are gone

The driver keeps only the handles of a framebuffer's views, and reads
every view of the pass through them when a render pass begins. A guest
that destroys a view, or its image, while a framebuffer naming it lives,
and then begins a render pass on that framebuffer, made the driver read
freed memory: KosmicKrisp ended the host process in
transition_attachment.

Record the view object of each framebuffer attachment and the image
object of each view, and the attachment count of each render pass. A
render pass begin whose render pass or framebuffer is missing, whose
framebuffer or begin info holds fewer views than the pass reads, or one
of whose views or their images the guest has destroyed, marks the
context lost instead of reaching the driver. An image view of no image
is refused in the same way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/venus/vkr_command_buffer.c | 27 +++++++++-
 src/venus/vkr_image.c          | 16 +++++-
 src/venus/vkr_image.h          |  4 ++
 src/venus/vkr_render_pass.c    | 97 +++++++++++++++++++++++++++++++++-
 src/venus/vkr_render_pass.h    | 19 +++++++
 5 files changed, 158 insertions(+), 5 deletions(-)

diff --git a/src/venus/vkr_command_buffer.c b/src/venus/vkr_command_buffer.c
index d47214b1b2873683764124e3d871e1ec88fbfe2b..a64a178845c9d83055ed419254909d912b8fe48a 100644
--- a/src/venus/vkr_command_buffer.c
+++ b/src/venus/vkr_command_buffer.c
@@ -6,6 +6,7 @@
 #include "vkr_command_buffer.h"
 
 #include "vkr_command_buffer_gen.h"
+#include "vkr_render_pass.h"
 
 #ifdef __clang__
 #pragma clang diagnostic ignored "-Wgnu-zero-variadic-macro-arguments"
@@ -497,10 +498,29 @@ vkr_dispatch_vkCmdPushConstants(UNUSED struct vn_dispatch_context *dispatch,
                 args->size, args->pValues);
 }
 
+/* The driver reads every attachment view through pointers the guest can
+ * have freed, so a begin that names one the guest destroyed ends the
+ * context rather than the host. */
+static bool
+vkr_command_buffer_begin_render_pass_is_valid(struct vn_dispatch_context *dispatch,
+                                              const VkRenderPassBeginInfo *info)
+{
+   struct vkr_context *ctx = dispatch->data;
+   if (vkr_render_pass_begin_is_valid(ctx, info))
+      return true;
+
+   vkr_log("render pass begin names a destroyed or missing attachment");
+   vkr_context_set_fatal(ctx);
+   return false;
+}
+
 static void
-vkr_dispatch_vkCmdBeginRenderPass(UNUSED struct vn_dispatch_context *dispatch,
+vkr_dispatch_vkCmdBeginRenderPass(struct vn_dispatch_context *dispatch,
                                   struct vn_command_vkCmdBeginRenderPass *args)
 {
+   if (!vkr_command_buffer_begin_render_pass_is_valid(dispatch, args->pRenderPassBegin))
+      return;
+
    VKR_CMD_CALL(CmdBeginRenderPass, args, args->pRenderPassBegin, args->contents);
 }
 
@@ -543,9 +563,12 @@ vkr_dispatch_vkCmdDispatchBase(UNUSED struct vn_dispatch_context *dispatch,
 }
 
 static void
-vkr_dispatch_vkCmdBeginRenderPass2(UNUSED struct vn_dispatch_context *dispatch,
+vkr_dispatch_vkCmdBeginRenderPass2(struct vn_dispatch_context *dispatch,
                                    struct vn_command_vkCmdBeginRenderPass2 *args)
 {
+   if (!vkr_command_buffer_begin_render_pass_is_valid(dispatch, args->pRenderPassBegin))
+      return;
+
    VKR_CMD_CALL(CmdBeginRenderPass2, args, args->pRenderPassBegin,
                 args->pSubpassBeginInfo);
 }
diff --git a/src/venus/vkr_image.c b/src/venus/vkr_image.c
index 0ec9ccc144668c58f5fefc6a0c32e9f05e6ab491..a4bc30c7655fd9517802d337285984f52021cf7e 100644
--- a/src/venus/vkr_image.c
+++ b/src/venus/vkr_image.c
@@ -353,7 +353,21 @@ static void
 vkr_dispatch_vkCreateImageView(struct vn_dispatch_context *dispatch,
                                struct vn_command_vkCreateImageView *args)
 {
-   vkr_image_view_create_and_add(dispatch->data, args);
+   struct vkr_context *ctx = dispatch->data;
+
+   /* Still the decoded object; creation replaces it with the driver's. */
+   const struct vkr_image *image = vkr_image_from_handle(args->pCreateInfo->image);
+   if (!image) {
+      vkr_log("image view of no image");
+      vkr_context_set_fatal(ctx);
+      return;
+   }
+
+   struct vkr_image_view *view = vkr_image_view_create_and_add(ctx, args);
+   if (view) {
+      view->image_id = image->base.id;
+      view->image_handle = image->base.handle.u64;
+   }
 }
 
 static void
diff --git a/src/venus/vkr_image.h b/src/venus/vkr_image.h
index 886ed62a32fbe8082b425dd0bdc11df88cd91665..0a3e29882e47216eded14475897c6c667efc3bd8 100644
--- a/src/venus/vkr_image.h
+++ b/src/venus/vkr_image.h
@@ -21,6 +21,10 @@ VKR_DEFINE_OBJECT_CAST(image, VK_OBJECT_TYPE_IMAGE, VkImage)
 
 struct vkr_image_view {
    struct vkr_object base;
+   /* The image the view was made of, so that a later use of the view can
+    * tell whether the guest has destroyed it since. */
+   vkr_object_id image_id;
+   uint64_t image_handle;
 };
 VKR_DEFINE_OBJECT_CAST(image_view, VK_OBJECT_TYPE_IMAGE_VIEW, VkImageView)
 
diff --git a/src/venus/vkr_render_pass.c b/src/venus/vkr_render_pass.c
index 0cb3d70a24bbf0a6acc7ed2db4d37eab2a8c21db..874de8d48c5ee5b954c73fd5f08ee2da3777e5bb 100644
--- a/src/venus/vkr_render_pass.c
+++ b/src/venus/vkr_render_pass.c
@@ -7,11 +7,15 @@
 
 #include "vkr_render_pass_gen.h"
 
+#include "vkr_image.h"
+
 static void
 vkr_dispatch_vkCreateRenderPass(struct vn_dispatch_context *dispatch,
                                 struct vn_command_vkCreateRenderPass *args)
 {
-   vkr_render_pass_create_and_add(dispatch->data, args);
+   struct vkr_render_pass *pass = vkr_render_pass_create_and_add(dispatch->data, args);
+   if (pass)
+      pass->attachment_count = args->pCreateInfo->attachmentCount;
 }
 
 static void
@@ -37,6 +41,7 @@ vkr_dispatch_vkCreateRenderPass2(struct vn_dispatch_context *dispatch,
       return;
    }
 
+   pass->attachment_count = args->pCreateInfo->attachmentCount;
    vkr_device_add_object(ctx, dev, &pass->base);
 }
 
@@ -75,7 +80,37 @@ static void
 vkr_dispatch_vkCreateFramebuffer(struct vn_dispatch_context *dispatch,
                                  struct vn_command_vkCreateFramebuffer *args)
 {
-   vkr_framebuffer_create_and_add(dispatch->data, args);
+   struct vkr_context *ctx = dispatch->data;
+   struct vkr_device *dev = vkr_device_from_handle(args->device);
+   const VkFramebufferCreateInfo *info = args->pCreateInfo;
+   const bool imageless = info->flags & VK_FRAMEBUFFER_CREATE_IMAGELESS_BIT;
+   const uint32_t count = imageless || !info->pAttachments ? 0 : info->attachmentCount;
+
+   struct vkr_framebuffer *fb = vkr_context_alloc_object(
+      ctx, sizeof(*fb) + sizeof(fb->attachments[0]) * count, VK_OBJECT_TYPE_FRAMEBUFFER,
+      args->pFramebuffer);
+   if (!fb) {
+      args->ret = VK_ERROR_OUT_OF_HOST_MEMORY;
+      return;
+   }
+
+   fb->attachment_count = count;
+   /* The views are still the decoded objects here; the driver handle
+    * replaces them below. */
+   for (uint32_t i = 0; i < count; i++) {
+      const struct vkr_image_view *view = vkr_image_view_from_handle(info->pAttachments[i]);
+      if (view) {
+         fb->attachments[i].id = view->base.id;
+         fb->attachments[i].handle = view->base.handle.u64;
+      }
+   }
+
+   if (vkr_framebuffer_create_driver_handle(ctx, args, fb) != VK_SUCCESS) {
+      free(fb);
+      return;
+   }
+
+   vkr_device_add_object(ctx, dev, &fb->base);
 }
 
 static void
@@ -85,6 +120,64 @@ vkr_dispatch_vkDestroyFramebuffer(struct vn_dispatch_context *dispatch,
    vkr_framebuffer_destroy_and_remove(dispatch->data, args);
 }
 
+/* An object id names the object only while the guest keeps it, and the
+ * handle it was made with tells it from a later object of the same id. */
+static const struct vkr_object *
+vkr_context_get_live_object(struct vkr_context *ctx,
+                            vkr_object_id id,
+                            VkObjectType type,
+                            uint64_t handle)
+{
+   const struct vkr_object *obj = vkr_context_get_object(ctx, id);
+   return obj && obj->type == type && obj->handle.u64 == handle ? obj : NULL;
+}
+
+static bool
+vkr_image_view_is_usable(struct vkr_context *ctx, const struct vkr_image_view *view)
+{
+   return view && vkr_context_get_live_object(ctx, view->image_id, VK_OBJECT_TYPE_IMAGE,
+                                              view->image_handle);
+}
+
+bool
+vkr_render_pass_begin_is_valid(struct vkr_context *ctx,
+                               const VkRenderPassBeginInfo *info)
+{
+   const struct vkr_render_pass *pass = vkr_render_pass_from_handle(info->renderPass);
+   const struct vkr_framebuffer *fb = vkr_framebuffer_from_handle(info->framebuffer);
+   if (!pass || !fb)
+      return false;
+
+   /* The driver takes the views from the begin info when it names any, and
+    * from the framebuffer otherwise, and reads one per pass attachment. */
+   const VkRenderPassAttachmentBeginInfo *begin_views =
+      vkr_find_struct(info->pNext, VK_STRUCTURE_TYPE_RENDER_PASS_ATTACHMENT_BEGIN_INFO);
+   if (begin_views && begin_views->attachmentCount) {
+      if (!begin_views->pAttachments ||
+          begin_views->attachmentCount < pass->attachment_count)
+         return false;
+      /* Decoded from this command, so each view exists unless it is null. */
+      for (uint32_t i = 0; i < pass->attachment_count; i++) {
+         if (!vkr_image_view_is_usable(
+                ctx, vkr_image_view_from_handle(begin_views->pAttachments[i])))
+            return false;
+      }
+      return true;
+   }
+
+   /* An imageless framebuffer keeps no views. */
+   if (fb->attachment_count < pass->attachment_count)
+      return false;
+   for (uint32_t i = 0; i < pass->attachment_count; i++) {
+      const struct vkr_framebuffer_attachment *att = &fb->attachments[i];
+      const struct vkr_image_view *view = (const struct vkr_image_view *)
+         vkr_context_get_live_object(ctx, att->id, VK_OBJECT_TYPE_IMAGE_VIEW, att->handle);
+      if (!vkr_image_view_is_usable(ctx, view))
+         return false;
+   }
+   return true;
+}
+
 void
 vkr_context_init_render_pass_dispatch(struct vkr_context *ctx)
 {
diff --git a/src/venus/vkr_render_pass.h b/src/venus/vkr_render_pass.h
index a6331b4d5bbc6d34f047a23281f8a0765e61ff25..b2eeb32f63d372cf5ac35bbf2e045e83498034fc 100644
--- a/src/venus/vkr_render_pass.h
+++ b/src/venus/vkr_render_pass.h
@@ -10,14 +10,33 @@
 
 struct vkr_render_pass {
    struct vkr_object base;
+   /* How many views a render pass begin hands the driver. */
+   uint32_t attachment_count;
 };
 VKR_DEFINE_OBJECT_CAST(render_pass, VK_OBJECT_TYPE_RENDER_PASS, VkRenderPass)
 
+/* A view a framebuffer was made with, as it was then. The driver keeps only
+ * the view's handle, so a guest that destroys the view leaves the
+ * framebuffer naming freed memory. */
+struct vkr_framebuffer_attachment {
+   vkr_object_id id;
+   uint64_t handle;
+};
+
 struct vkr_framebuffer {
    struct vkr_object base;
+   uint32_t attachment_count;
+   struct vkr_framebuffer_attachment attachments[];
 };
 VKR_DEFINE_OBJECT_CAST(framebuffer, VK_OBJECT_TYPE_FRAMEBUFFER, VkFramebuffer)
 
+/* Whether every view a render pass begin hands the driver, and the image of
+ * each, still exists. Called on the decoded command, before its handles are
+ * replaced by the driver's. */
+bool
+vkr_render_pass_begin_is_valid(struct vkr_context *ctx,
+                               const VkRenderPassBeginInfo *info);
+
 void
 vkr_context_init_render_pass_dispatch(struct vkr_context *ctx);
 
